---
import BaseLayout from '@layouts/BaseLayout.astro';
import { vencimientos2026, CATEGORY_LABELS, DISCLAIMER } from '@lib/vencimientos';
import type { TaxCategory } from '@lib/vencimientos';

const categories: TaxCategory[] = ['todos', 'monotributo', 'ri', 'sociedades'];
const allData = JSON.stringify(vencimientos2026);
---
<BaseLayout
  practice="accounting"
  title="PLB — Calendario de Vencimientos AFIP 2026 · Buenos Aires"
  description="Calendario interactivo de vencimientos impositivos AFIP Argentina 2026. Monotributo, IVA, Ganancias, Bienes Personales, Cargas Sociales. Estudio PLB Contable.">

  <section class="ven-hero">
    <div class="shell py-14 md:py-20">
      <div class="reveal">
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.28em] font-semibold" style="color: var(--brand-500)">
          Área Contable · AFIP
        </span>
        <h1 class="mt-4 font-sans font-bold leading-[1.08] tracking-tight"
            style="font-size: clamp(2rem, 4.5vw, 3.4rem); color: var(--fg);">
          Calendario de<br/>
          <span style="color: var(--brand-500)">Vencimientos 2026</span>
        </h1>
        <p class="mt-5 max-w-[600px] text-[0.96rem] leading-relaxed" style="color: var(--fg-muted);">
          Fechas clave de AFIP. Hacé clic en un día para ver los vencimientos.
          Filtrá por tipo de contribuyente.
        </p>
      </div>

      <!-- Filtros -->
      <div class="mt-8 flex flex-wrap gap-2" id="ven-filters" role="group" aria-label="Filtrar por tipo de contribuyente">
        {categories.map((cat) => (
          <button class="ven-filter-btn" data-cat={cat} aria-pressed={cat === 'todos' ? 'true' : 'false'}>
            {CATEGORY_LABELS[cat]}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Calendario -->
  <section class="shell pb-20">
    <div class="cal-wrap">
      <!-- Grid del calendario -->
      <div class="cal-main">
        <div class="cal-toolbar">
          <button id="cal-prev" class="cal-nav" aria-label="Mes anterior">‹</button>
          <h2 id="cal-title" class="cal-title">—</h2>
          <button id="cal-next" class="cal-nav" aria-label="Mes siguiente">›</button>
          <button id="cal-today" class="cal-today-btn">Hoy</button>
        </div>

        <div class="cal-weekdays">
          <span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
        </div>

        <div id="cal-grid" class="cal-grid"></div>

        <div class="cal-legend">
          <span class="cal-legend-item"><span class="cal-dot cal-dot--mt"></span>Monotributo</span>
          <span class="cal-legend-item"><span class="cal-dot cal-dot--ri"></span>Resp. Inscripto</span>
          <span class="cal-legend-item"><span class="cal-dot cal-dot--soc"></span>Sociedades</span>
        </div>
      </div>

      <!-- Panel de detalle -->
      <aside class="cal-detail" aria-live="polite">
        <span class="cal-detail-kicker font-mono">Vencimientos del día</span>
        <h3 id="cal-detail-date" class="cal-detail-date">—</h3>
        <div id="cal-detail-list" class="cal-detail-list"></div>
      </aside>
    </div>

    <p class="mt-10 font-mono text-[0.62rem] leading-relaxed" style="color: var(--fg-muted); max-width: 680px;">
      ⚠ {DISCLAIMER}
    </p>
  </section>

  <!-- CTA -->
  <section class="ven-cta">
    <div class="shell py-14 text-center">
      <p class="font-sans font-semibold text-[1.1rem] mb-5" style="color: var(--fg);">
        ¿Necesitás que un contador lleve el control por vos?
      </p>
      <a href="#contacto" class="btn-editorial">Contactar al equipo contable</a>
    </div>
  </section>

  <div id="contacto" class="shell py-12 text-center" style="border-top: 1px solid var(--border);">
    <p class="font-mono text-[0.7rem] uppercase tracking-widest mb-4" style="color: var(--fg-muted)">
      Pantarotto Lértora Bardagí & Asocs.
    </p>
    <p style="color: var(--fg-muted); font-size: 0.9rem;">
      Av. Corrientes 1464, Piso 16 · Buenos Aires ·
      <a href="mailto:estudio@plb.com.ar" style="color: var(--brand-500); text-decoration: underline;">
        estudio@plb.com.ar
      </a>
    </p>
  </div>
</BaseLayout>

<script define:vars={{ allData }}>
  (function () {
    var data = JSON.parse(allData);

    var MONTHS    = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var WEEKDAYS  = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    var CAT_LABEL = { monotributo: 'Monotributo', ri: 'Resp. Inscripto', sociedades: 'Sociedades' };

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    var viewYear  = today.getFullYear();
    var viewMonth = today.getMonth();
    var selectedISO = isoFromYMD(today.getFullYear(), today.getMonth(), today.getDate());
    var activeFilter = 'todos';

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function isoFromYMD(y, m, d) { return y + '-' + pad(m + 1) + '-' + pad(d); }

    function eventsForISO(iso) {
      return data.filter(function (v) {
        if (v.date !== iso) return false;
        if (activeFilter === 'todos') return true;
        return v.categories.indexOf(activeFilter) >= 0;
      });
    }

    function eventsForMonth(year, month) {
      var prefix = year + '-' + pad(month + 1);
      return data.filter(function (v) {
        if (v.date.indexOf(prefix) !== 0) return false;
        if (activeFilter === 'todos') return true;
        return v.categories.indexOf(activeFilter) >= 0;
      });
    }

    function dotClass(cats) {
      // Color según categoría predominante
      if (cats.indexOf('monotributo') >= 0 && cats.length === 1) return 'cal-dot--mt';
      if (cats.indexOf('sociedades')  >= 0) return 'cal-dot--soc';
      if (cats.indexOf('ri')          >= 0) return 'cal-dot--ri';
      return 'cal-dot--mt';
    }

    function renderCalendar() {
      var titleEl = document.getElementById('cal-title');
      titleEl.textContent = MONTHS[viewMonth] + ' ' + viewYear;

      var first = new Date(viewYear, viewMonth, 1);
      // Lunes = 0, Domingo = 6
      var firstWeekday = (first.getDay() + 6) % 7;
      var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      var html = '';

      // Celdas vacías al inicio
      for (var i = 0; i < firstWeekday; i++) {
        html += '<div class="cal-cell cal-cell--empty" aria-hidden="true"></div>';
      }

      for (var day = 1; day <= daysInMonth; day++) {
        var iso = isoFromYMD(viewYear, viewMonth, day);
        var events = eventsForISO(iso);
        var d = new Date(viewYear, viewMonth, day);
        var isToday    = d.getTime() === today.getTime();
        var isSelected = iso === selectedISO;
        var isPast     = d < today;

        var classes = 'cal-cell';
        if (isToday)    classes += ' cal-cell--today';
        if (isSelected) classes += ' cal-cell--selected';
        if (isPast && !isToday) classes += ' cal-cell--past';
        if (events.length > 0)  classes += ' cal-cell--has';

        html += '<button class="' + classes + '" data-iso="' + iso + '" type="button">';
        html += '<span class="cal-num">' + day + '</span>';

        if (events.length > 0) {
          html += '<span class="cal-dots">';
          var maxDots = Math.min(events.length, 4);
          for (var k = 0; k < maxDots; k++) {
            html += '<span class="cal-dot ' + dotClass(events[k].categories) + '"></span>';
          }
          html += '</span>';
        }
        html += '</button>';
      }

      var grid = document.getElementById('cal-grid');
      grid.innerHTML = html;

      // Click handlers
      grid.querySelectorAll('[data-iso]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          selectedISO = btn.getAttribute('data-iso');
          renderCalendar();
          renderDetail();
        });
      });
    }

    function renderDetail() {
      var parts = selectedISO.split('-');
      var d = new Date(+parts[0], +parts[1] - 1, +parts[2]);
      var dateLabel = WEEKDAYS[d.getDay()] + ' ' + d.getDate() + ' de ' + MONTHS[d.getMonth()];
      document.getElementById('cal-detail-date').textContent = dateLabel;

      var events = eventsForISO(selectedISO);
      var listEl = document.getElementById('cal-detail-list');

      if (events.length === 0) {
        listEl.innerHTML = '<p class="cal-empty">Sin vencimientos este día.</p>';
        return;
      }

      var html = '';
      events.forEach(function (v) {
        var cats = v.categories.map(function (c) { return CAT_LABEL[c] || c; }).join(' · ');
        html += '<div class="cal-event">';
        html += '<span class="cal-event-cats font-mono">' + cats + '</span>';
        html += '<h4 class="cal-event-label">' + v.label + '</h4>';
        html += '<p class="cal-event-detail">' + v.detail + '</p>';
        html += '</div>';
      });
      listEl.innerHTML = html;
    }

    // Navegación
    document.getElementById('cal-prev').addEventListener('click', function () {
      viewMonth--;
      if (viewMonth < 0) { viewMonth = 11; viewYear--; }
      renderCalendar();
    });
    document.getElementById('cal-next').addEventListener('click', function () {
      viewMonth++;
      if (viewMonth > 11) { viewMonth = 0; viewYear++; }
      renderCalendar();
    });
    document.getElementById('cal-today').addEventListener('click', function () {
      viewYear = today.getFullYear();
      viewMonth = today.getMonth();
      selectedISO = isoFromYMD(today.getFullYear(), today.getMonth(), today.getDate());
      renderCalendar();
      renderDetail();
    });

    // Filtros
    document.querySelectorAll('[data-cat]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeFilter = btn.getAttribute('data-cat');
        document.querySelectorAll('[data-cat]').forEach(function (b) {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        renderCalendar();
        renderDetail();
      });
    });

    renderCalendar();
    renderDetail();
  })();
</script>

<style>
  .ven-hero { border-bottom: 1px solid var(--border); }
  .ven-cta  { border-top: 1px solid var(--border); }

  /* ── Filtros ── */
  .ven-filter-btn {
    padding: 0.4rem 1rem;
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    border: 1.5px solid var(--border);
    color: var(--fg-muted);
    background: transparent;
    border-radius: 3px;
    cursor: pointer;
    transition: all .2s ease;
  }
  .ven-filter-btn:hover,
  .ven-filter-btn[aria-pressed='true'] {
    border-color: var(--brand-500);
    color: var(--fg);
    background: color-mix(in srgb, var(--brand-500) 10%, transparent);
  }

  /* ── Calendario layout ── */
  .cal-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-top: 2rem;
  }
  @media (min-width: 960px) {
    .cal-wrap { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; }
  }

  /* ── Toolbar ── */
  .cal-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .cal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-sans, system-ui);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.01em;
  }
  .cal-nav {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: transparent;
    color: var(--fg);
    font-size: 1.2rem;
    cursor: pointer;
    transition: all .15s ease;
  }
  .cal-nav:hover { border-color: var(--brand-500); color: var(--brand-500); }
  .cal-today-btn {
    padding: 0 0.85rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: transparent;
    color: var(--fg-muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: all .15s ease;
  }
  .cal-today-btn:hover { border-color: var(--brand-500); color: var(--brand-500); }

  /* ── Weekdays header ── */
  .cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 700;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  /* ── Grid ── */
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-top: 0;
  }
  .cal-cell {
    aspect-ratio: 1 / 1;
    background: var(--bg);
    border: 0;
    padding: 0.4rem 0.4rem 0.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    cursor: pointer;
    text-align: left;
    transition: background .15s ease;
    color: var(--fg);
    position: relative;
    min-height: 56px;
  }
  .cal-cell:hover:not(.cal-cell--empty) { background: color-mix(in srgb, var(--brand-500) 7%, var(--bg)); }
  .cal-cell--empty { cursor: default; background: transparent; }
  .cal-num {
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .cal-cell--past .cal-num { color: var(--fg-muted); opacity: 0.5; }
  .cal-cell--past { background: color-mix(in srgb, var(--fg-muted) 5%, var(--bg)); }
  .cal-cell--today {
    box-shadow: inset 0 0 0 2px var(--brand-500);
  }
  .cal-cell--today .cal-num { color: var(--brand-500); font-weight: 800; }
  .cal-cell--selected:not(.cal-cell--today) {
    background: color-mix(in srgb, var(--brand-500) 18%, var(--bg));
  }
  .cal-cell--selected.cal-cell--today {
    background: color-mix(in srgb, var(--brand-500) 18%, var(--bg));
  }

  .cal-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .cal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-500);
    display: inline-block;
  }
  .cal-dot--mt  { background: #f59e0b; }
  .cal-dot--ri  { background: var(--brand-500); }
  .cal-dot--soc { background: #8b5cf6; }

  /* ── Legend ── */
  .cal-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .cal-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 600;
  }

  /* ── Panel detalle ── */
  .cal-detail {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: color-mix(in srgb, var(--brand-500) 3%, transparent);
    align-self: start;
    position: sticky;
    top: 5.5rem;
  }
  .cal-detail-kicker {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-500);
    font-weight: 700;
  }
  .cal-detail-date {
    font-family: var(--font-sans, system-ui);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--fg);
    margin: 0.4rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .cal-detail-list { display: flex; flex-direction: column; gap: 0.85rem; }
  .cal-event {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg);
  }
  .cal-event-cats {
    display: block;
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-500);
    margin-bottom: 0.3rem;
    font-weight: 700;
  }
  .cal-event-label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.25rem;
  }
  .cal-event-detail {
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
  }
  .cal-empty {
    color: var(--fg-muted);
    font-size: 0.85rem;
    padding: 0.5rem 0;
    font-style: italic;
  }
</style>
