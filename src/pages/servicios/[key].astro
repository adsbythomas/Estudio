---
import BaseLayout from '@layouts/BaseLayout.astro';
import { accounting } from '@lib/accounting';

export function getStaticPaths() {
  return accounting.practice.items.map((service) => ({
    params: { key: service.key },
    props: { service },
  }));
}

const { service } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
---
<BaseLayout
  practice="accounting"
  title={`${service.name} — PLB Contable`}
  description={service.desc}
  landing={false}
>
  <section class="service-hero">
    <div class="shell">
      <a href={withBase('/contable#practica')} class="service-back">
        <span aria-hidden="true">←</span> Volver a servicios
      </a>

      <h1 class="service-title" data-word-reveal>
        <span style="color: var(--brand-500)">{service.name}</span>
      </h1>

      <p class="service-intro" set:html={service.intro || service.desc}></p>
    </div>
  </section>

  {service.services && service.services.length > 0 && (
    <section class="service-list">
      <div class="shell">
        <div class="section-kicker"><span>Qué incluye</span></div>
        <h2 class="service-list-title">
          Cobertura del servicio.
        </h2>

        <div class="service-grid">
          {service.services.map((s, i) => (
            <article class="service-card reveal">
              <div class="service-num">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h3 class="service-card-title">{s.title}</h3>
                <p class="service-card-desc">{s.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="service-cta">
    <div class="shell">
      <div class="service-cta-card">
        <span class="service-cta-label">Próximo paso</span>
        <h2 class="service-cta-title">
          ¿Necesita asesoramiento en {service.meetingTopic || service.name.toLowerCase()}?
        </h2>
        <p class="service-cta-desc">
          Coordinamos una primera reunión para evaluar su situación contable e impositiva.
          Confidencial, dentro de las 24 horas hábiles.
        </p>
        <div class="service-cta-actions">
          <a href={withBase('/contable#agenda')} class="service-cta-primary">
            <span>Solicitar reunión sobre {service.meetingTopic || service.name.toLowerCase()}</span>
            <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M1 5h14M11 1l4 4-4 4"/>
            </svg>
          </a>
          <a href={withBase('/contable#contacto')} class="service-cta-secondary">
            O escribir al estudio
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero { position: relative; padding: 8rem 0 4rem; }
  .service-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    transition: color .25s ease;
  }
  .service-back:hover { color: var(--brand-500); }

  .service-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(2.2rem, 5.4vw, 3.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 2rem;
    max-width: 1100px;
  }
  .service-intro {
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--fg-muted);
    max-width: 780px;
  }

  .service-list { padding: 4rem 0; border-top: 1px solid var(--border); }
  .service-list-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 3rem;
    max-width: 800px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .service-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color .3s ease, transform .3s ease;
  }
  .service-card:hover {
    border-color: var(--brand-500);
    transform: translateY(-2px);
  }
  .service-num {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.78rem;
    color: var(--brand-500);
    letter-spacing: 0.1em;
    line-height: 1;
    margin-top: 0.25rem;
  }
  .service-card-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.55rem 0;
    line-height: 1.3;
  }
  .service-card-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }

  .service-cta { padding: 3rem 0 6rem; }
  .service-cta-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3rem 2.5rem;
    background: var(--surface);
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }
  .service-cta-label {
    display: inline-block;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze-500);
    margin-bottom: 1.25rem;
  }
  .service-cta-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    margin: 0 0 1rem 0;
  }
  .service-cta-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0 auto 2rem;
    max-width: 540px;
  }
  .service-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: center;
    align-items: center;
  }
  .service-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.75rem;
    background: var(--brand-500);
    color: var(--bg);
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: all .3s cubic-bezier(0.2, 0.6, 0.2, 1);
    box-shadow: 0 4px 14px -6px color-mix(in oklab, var(--brand-500) 70%, transparent);
  }
  .service-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -6px color-mix(in oklab, var(--brand-500) 80%, transparent);
  }
  .service-cta-secondary {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze-500);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity .25s ease;
  }
  .service-cta-secondary:hover { opacity: 0.7; }

  @media (max-width: 768px) {
    .service-hero { padding: 6rem 0 2.5rem; }
    .service-list { padding: 3rem 0; }
    .service-cta { padding: 2rem 0 4rem; }
    .service-cta-card { padding: 2rem 1.5rem; }
  }
</style>
