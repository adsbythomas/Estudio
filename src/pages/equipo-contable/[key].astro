---
import BaseLayout from '@layouts/BaseLayout.astro';
import { accounting } from '@lib/accounting';

export function getStaticPaths() {
  return accounting.team.members
    .filter((m) => !!m.key)
    .map((member) => ({
      params: { key: member.key as string },
      props: { member },
    }));
}

const { member } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
---
<BaseLayout
  practice="accounting"
  title={`${member.name} — PLB Contable`}
  description={`Perfil profesional de ${member.name}, ${member.role} del área contable del estudio Pantarotto Lértora Bardagí.`}
  landing={false}
>
  <section class="member-hero">
    <div class="shell">
      <a href={withBase('/contable#equipo')} class="member-back">
        <span aria-hidden="true">←</span> Volver al equipo
      </a>

      <div class="member-grid">
        <div class="member-photo">
          <span class="member-photo-fallback" aria-hidden="true">{member.initials}</span>
          {member.photo && (
            <img
              src={withBase(member.photo)}
              alt={`Foto de ${member.name}`}
              onerror="this.style.display='none'"
            />
          )}
        </div>

        <div class="member-info">
          <div class="member-role">{member.role}</div>
          <h1 class="member-name" data-word-reveal>{member.name}</h1>
          {member.spec && <div class="member-spec">{member.spec}</div>}

          <div class="member-bio">
            <p>Aca va la informacion de cada uno.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .member-hero { padding: 8rem 0 6rem; }
  .member-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    transition: color .25s ease;
  }
  .member-back:hover { color: var(--brand-500); }

  .member-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 768px) {
    .member-grid {
      grid-template-columns: minmax(260px, 360px) 1fr;
      gap: 4rem;
    }
  }

  .member-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg,
      color-mix(in oklab, var(--brand-500) 22%, var(--surface-2)),
      var(--surface-2));
    border: 1px solid var(--border);
  }
  .member-photo-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    color: var(--brand-500);
    letter-spacing: 0.04em;
    opacity: 0.55;
  }
  .member-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .member-role {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-500);
    margin-bottom: 1rem;
  }
  .member-name {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .member-spec {
    font-size: 1rem;
    color: var(--fg-muted);
    margin-bottom: 2rem;
    line-height: 1.5;
  }
  .member-bio {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--fg-muted);
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }
  .member-bio p { margin: 0 0 1rem; }
</style>
