---
import BaseLayout from '@layouts/BaseLayout.astro';
import { legalRadar } from '@lib/news';
import { legal } from '@lib/legal';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return legalRadar.items.map((item) => ({
    params: { slug: item.slug },
    props:  { item },
  }));
};

const { item } = Astro.props as any;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

// Mapeo de las categorías del radar a los `key` de las áreas legales que ya
// tienen subpágina. Así podemos linkear cada novedad a las áreas relevantes.
const CATEGORY_TO_AREA: Record<string, string> = {
  aerocomercial:  'aerocomercial',
  laboral:        'laboral',
  societario:     'societario',
  penal_economico:'penal',
  tributario:     'tributario',
};

// Áreas relacionadas (cruza categorías con áreas legales que tienen subpágina).
const relatedAreas = (item.categories || [])
  .map((c: string) => CATEGORY_TO_AREA[c])
  .filter(Boolean)
  .map((key: string) => legal.practice.items.find((a) => a.key === key))
  .filter(Boolean);

const sourceShort = (item.source || '').split('·')[0].trim();
---
<BaseLayout
  practice="legal"
  title={`${item.title} — Novedades PLB`}
  description={item.desc}
  landing={false}>

  <article class="article-page">
    <div class="shell">
      <a href={withBase('/novedades')} class="article-back">
        <span aria-hidden="true">←</span> Todas las novedades
      </a>

      <!-- Metadata: fecha · fuente · chips de categoría -->
      <div class="article-meta">
        <span class="article-meta-date">{item.date}</span>
        <span class="article-meta-sep" aria-hidden="true">·</span>
        <span class="article-meta-source">{item.source}</span>
      </div>

      <h1 class="article-title">{item.title}</h1>

      <p class="article-lead">{item.desc}</p>

      {item.categories && item.categories.length > 0 && (
        <div class="article-chips">
          {item.categories.map((c: string) => (
            <span class="article-chip">{c.replace(/_/g, ' ')}</span>
          ))}
        </div>
      )}

      <!-- Resumen extendido (cuando se carga manualmente en el JSON) o fallback -->
      <section class="article-section">
        <h2 class="article-h2">Resumen</h2>
        <div class="article-prose">
          {item.summary ? (
            <p>{item.summary}</p>
          ) : (
            <p>{item.desc}</p>
          )}
        </div>
      </section>

      <!-- Puntos clave (bullets) si vienen cargados -->
      {item.keyPoints && item.keyPoints.length > 0 && (
        <section class="article-section">
          <h2 class="article-h2">Puntos clave</h2>
          <ul class="article-bullets">
            {item.keyPoints.map((kp: string) => (
              <li>{kp}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Cómo impacta a la empresa, si está cargado -->
      {item.impact && (
        <section class="article-section">
          <h2 class="article-h2">Cómo impacta</h2>
          <div class="article-prose">
            <p>{item.impact}</p>
          </div>
        </section>
      )}

      <!-- Áreas legales relacionadas — linkea a las subpáginas de áreas -->
      {relatedAreas.length > 0 && (
        <section class="article-section">
          <h2 class="article-h2">Áreas relacionadas</h2>
          <div class="article-areas-grid">
            {relatedAreas.map((area: any) => (
              <a href={withBase(`/areas/${area.key}`)} class="article-area-card">
                <div class="article-area-name">{area.name}</div>
                <div class="article-area-desc">{area.desc}</div>
                <span class="article-area-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Fuente oficial -->
      <section class="article-section article-source">
        <h2 class="article-h2">Texto oficial</h2>
        <p class="article-prose">
          Esta novedad se nutre del Boletín Oficial y de los organismos competentes.
          Para el detalle completo y vinculante, acceda a la fuente:
        </p>
        <a href={item.url} target="_blank" rel="noopener" class="article-source-btn">
          <span>Leer en {sourceShort || 'la fuente oficial'}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </section>

      <!-- CTA: solicitar reunión sobre la novedad -->
      <section class="article-cta">
        <span class="article-cta-label">Próximo paso</span>
        <h2 class="article-cta-title">¿Necesita una opinión sobre cómo esta norma afecta a su empresa?</h2>
        <p class="article-cta-desc">
          Coordinamos una primera reunión para evaluar el impacto puntual sobre su operación,
          dentro de las 24 horas hábiles. Confidencial.
        </p>
        <div class="article-cta-actions">
          <a href={withBase('/#agenda')} class="article-cta-primary">
            <span>Solicitar reunión</span>
            <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 5h14M11 1l4 4-4 4"/></svg>
          </a>
          <a href={withBase('/#contacto')} class="article-cta-secondary">
            O escribir al estudio
          </a>
        </div>
      </section>

      <!-- Disclaimer -->
      <aside class="article-disclaimer">
        <strong>Importante.</strong>
        Este resumen tiene fines informativos y no reemplaza el asesoramiento profesional.
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 8rem 0 6rem;
  }
  .article-page .shell {
    max-width: 880px;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    transition: color .25s ease;
  }
  .article-back:hover { color: var(--brand-500); }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .article-meta-date { color: var(--brand-500); }
  .article-meta-sep { opacity: 0.4; }

  .article-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 1.5rem;
  }

  .article-lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0 0 2rem;
  }

  .article-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
  }
  .article-chip {
    padding: 0.4rem 0.8rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .article-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .article-h2 {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin: 0 0 1.25rem;
  }
  .article-prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }

  .article-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article-bullets li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }
  .article-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.5rem;
    height: 1px;
    background: var(--brand-500);
  }

  .article-areas-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .article-area-card {
    display: block;
    position: relative;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color .3s ease, transform .3s ease;
  }
  .article-area-card:hover {
    border-color: var(--brand-500);
    transform: translateY(-2px);
  }
  .article-area-name {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 0.45rem;
  }
  .article-area-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
    margin-right: 1.5rem;
  }
  .article-area-arrow {
    position: absolute;
    right: 1.25rem;
    top: 1.25rem;
    color: var(--brand-500);
    font-size: 1.2rem;
    transition: transform .25s ease;
  }
  .article-area-card:hover .article-area-arrow { transform: translateX(4px); }

  .article-source-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg);
    transition: all .25s ease;
  }
  .article-source-btn:hover {
    border-color: var(--brand-500);
    color: var(--brand-500);
  }

  .article-cta {
    margin-top: 3rem;
    padding: 2.5rem 2rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-align: center;
  }
  .article-cta-label {
    display: inline-block;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze-500);
    margin-bottom: 1rem;
  }
  .article-cta-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--fg);
    margin: 0 0 0.75rem;
  }
  .article-cta-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0 auto 1.75rem;
    max-width: 540px;
  }
  .article-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    justify-content: center;
    align-items: center;
  }
  .article-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.6rem;
    background: var(--brand-500);
    color: var(--bg);
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: all .3s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .article-cta-primary:hover {
    transform: translateY(-2px);
  }
  .article-cta-secondary {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze-500);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity .25s ease;
  }
  .article-cta-secondary:hover { opacity: 0.7; }

  .article-disclaimer {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .article-disclaimer strong {
    color: var(--fg);
    margin-right: 0.35em;
  }

  @media (max-width: 768px) {
    .article-page { padding: 6rem 0 4rem; }
    .article-cta { padding: 2rem 1.25rem; }
  }
</style>
