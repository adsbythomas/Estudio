---
import BaseLayout from '@layouts/BaseLayout.astro';
import { legal } from '@lib/legal';

export function getStaticPaths() {
  return legal.practice.items.map((area) => ({
    params: { key: area.key },
    props: { area },
  }));
}

const { area } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
---
<BaseLayout
  practice="legal"
  title={`${area.name} — PL Abogados`}
  description={area.desc}
  landing={false}
>
  <!-- Header del área: kicker + nombre del área + intro -->
  <section class="area-hero">
    <div class="shell">
      <a href={withBase('/#practica')} class="area-back">
        <span aria-hidden="true">←</span> Volver a áreas
      </a>

      <h1 class="area-title">
        Derecho <span style="color: var(--brand-500)">{area.name.toLowerCase()}</span>
      </h1>

      <p class="area-intro" set:html={area.intro || area.desc}></p>
    </div>
  </section>

  <!-- Servicios específicos del área -->
  {area.services && area.services.length > 0 && (
    <section class="area-services">
      <div class="shell">
        <div class="section-kicker"><span>Qué incluye</span></div>
        <h2 class="area-services-title">
          Cobertura del área <span style="color: var(--brand-500)">{area.name.toLowerCase()}</span>.
        </h2>

        <div class="area-services-grid">
          {area.services.map((s, i) => (
            <article class="area-service-card reveal">
              <div class="area-service-num">{String(i + 1).padStart(2, '0')}</div>
              <div>
                <h3 class="area-service-title">{s.title}</h3>
                <p class="area-service-desc">{s.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA: Solicitar reunión sobre [tema del área] -->
  <section class="area-cta">
    <div class="shell">
      <div class="area-cta-card">
        <span class="area-cta-label">Próximo paso</span>
        <h2 class="area-cta-title">
          ¿Necesita asesoramiento en {area.meetingTopic || `derecho ${area.name.toLowerCase()}`}?
        </h2>
        <p class="area-cta-desc">
          Coordinamos una primera reunión para evaluar su caso. Confidencial,
          dentro de las 24 horas hábiles.
        </p>
        <div class="area-cta-actions">
          <a href={withBase('/#agenda')} class="area-cta-primary">
            <span>Solicitar reunión sobre {area.meetingTopic || `derecho ${area.name.toLowerCase()}`}</span>
            <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M1 5h14M11 1l4 4-4 4"/>
            </svg>
          </a>
          <a href={withBase('/#contacto')} class="area-cta-secondary">
            O escribir al estudio
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─────────── Hero del área ─────────── */
  .area-hero {
    position: relative;
    padding: 8rem 0 4rem;
  }
  .area-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 3rem;
    transition: color .25s ease;
  }
  .area-back:hover { color: var(--brand-500); }

  .area-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 2rem;
    max-width: 1100px;
  }

  .area-intro {
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
    color: var(--fg-muted);
    max-width: 760px;
  }

  /* ─────────── Servicios ─────────── */
  .area-services {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }
  .area-services-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 3rem;
    max-width: 800px;
  }
  .area-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .area-service-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color .3s ease, transform .3s ease;
  }
  .area-service-card:hover {
    border-color: var(--brand-500);
    transform: translateY(-2px);
  }
  .area-service-num {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.78rem;
    color: var(--brand-500);
    letter-spacing: 0.1em;
    line-height: 1;
    margin-top: 0.25rem;
  }
  .area-service-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.55rem 0;
    line-height: 1.3;
  }
  .area-service-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }

  /* ─────────── CTA final ─────────── */
  .area-cta {
    padding: 3rem 0 6rem;
  }
  .area-cta-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3rem 2.5rem;
    background: var(--surface);
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }
  .area-cta-label {
    display: inline-block;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze-500);
    margin-bottom: 1.25rem;
  }
  .area-cta-title {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: clamp(1.4rem, 2.8vw, 1.95rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--fg);
    margin: 0 0 1rem 0;
  }
  .area-cta-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0 auto 2rem;
    max-width: 540px;
  }
  .area-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: center;
    align-items: center;
  }
  .area-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.75rem;
    background: var(--brand-500);
    color: var(--bg);
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
    transition: all .3s cubic-bezier(0.2, 0.6, 0.2, 1);
    box-shadow: 0 4px 14px -6px color-mix(in oklab, var(--brand-500) 70%, transparent);
  }
  .area-cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px -6px color-mix(in oklab, var(--brand-500) 80%, transparent);
  }
  .area-cta-secondary {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze-500);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity .25s ease;
  }
  .area-cta-secondary:hover { opacity: 0.7; }

  @media (max-width: 768px) {
    .area-hero { padding: 6rem 0 2.5rem; }
    .area-services { padding: 3rem 0; }
    .area-cta { padding: 2rem 0 4rem; }
    .area-cta-card { padding: 2rem 1.5rem; }
  }
</style>
