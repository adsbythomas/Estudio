---
/**
 * Formulario para iniciar un trámite societario.
 * Envía por POST a Web3Forms (https://web3forms.com) si site.web3formsKey
 * está configurada. Si no, hace fallback a mailto: con los datos en el body.
 */
import { site } from '@lib/site';
import type { Tramite, FormField } from '@data/types';

export interface Props {
  tramite: Tramite;
}
const { tramite } = Astro.props;
const hasKey = (site as any).web3formsKey && (site as any).web3formsKey.length > 0;
const formId = `tramite-form-${tramite.key}`;

// Campos fijos de contacto que aparecen en TODOS los trámites.
const contactFields: FormField[] = [
  { name: 'nombre',   label: 'Nombre y apellido', type: 'text',  required: true,  placeholder: 'Juan Pérez' },
  { name: 'rol',      label: 'Rol o cargo',        type: 'text',                    placeholder: 'Socio fundador' },
  { name: 'email',    label: 'Email',              type: 'email', required: true,  placeholder: 'juan@empresa.com' },
  { name: 'telefono', label: 'Teléfono',           type: 'tel',                     placeholder: '+54 9 11 ...' },
];

const extra = tramite.extraFields ?? [];
---
<section id="iniciar" class="tramite-form-section">
  <div class="shell">
    <span class="tramite-form-label">Formulario de carga</span>
    <h2 class="tramite-form-title">Iniciar trámite — {tramite.name}</h2>
    <p class="tramite-form-sub">
      Le tomará entre 5 y 8 minutos. Cuanta más información cargue, antes podremos asignarle un abogado.
    </p>

    <form
      id={formId}
      class="tramite-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      enctype="multipart/form-data"
      data-has-key={hasKey ? 'true' : 'false'}
      data-tramite={tramite.key}
      data-contact-email={site.contactEmail}
    >
      <!-- Web3Forms metadata (sólo se usa si la clave está cargada) -->
      <input type="hidden" name="access_key" value={(site as any).web3formsKey} />
      <input type="hidden" name="subject" value={`Nuevo trámite — ${tramite.name}`} />
      <input type="hidden" name="from_name" value="Sitio PL Abogados · Societario" />
      <input type="hidden" name="redirect" value="false" />
      <input type="hidden" name="tramite_key" value={tramite.key} />
      <input type="hidden" name="tramite_nombre" value={tramite.name} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

      <!-- Sección: Datos de contacto -->
      <fieldset class="tramite-form-fieldset">
        <legend>01 · Datos de contacto</legend>
        <div class="tramite-form-grid">
          {contactFields.map((f) => (
            <label class={`tramite-form-field ${f.type === 'textarea' ? 'tramite-form-field--full' : ''}`}>
              <span class="tramite-form-fieldlabel">{f.label}{f.required && <em aria-hidden="true">*</em>}</span>
              {f.type === 'textarea'
                ? <textarea name={f.name} placeholder={f.placeholder} required={f.required} rows={3}></textarea>
                : <input name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
              }
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Sección: Datos específicos del trámite -->
      {extra.length > 0 && (
        <fieldset class="tramite-form-fieldset">
          <legend>02 · Datos del trámite</legend>
          <div class="tramite-form-grid">
            {extra.map((f) => (
              <label class={`tramite-form-field ${f.fullWidth || f.type === 'textarea' ? 'tramite-form-field--full' : ''}`}>
                <span class="tramite-form-fieldlabel">{f.label}{f.required && <em aria-hidden="true">*</em>}</span>
                {f.type === 'textarea' && (
                  <textarea name={f.name} placeholder={f.placeholder} required={f.required} rows={3}></textarea>
                )}
                {f.type === 'select' && (
                  <select name={f.name} required={f.required}>
                    <option value="">Seleccione una opción…</option>
                    {(f.options || []).map((o) => <option value={o}>{o}</option>)}
                  </select>
                )}
                {(f.type === 'text' || f.type === 'email' || f.type === 'tel') && (
                  <input name={f.name} type={f.type} placeholder={f.placeholder} required={f.required} />
                )}
              </label>
            ))}
          </div>
        </fieldset>
      )}

      <!-- Sección: Mensaje libre -->
      <fieldset class="tramite-form-fieldset">
        <legend>{extra.length > 0 ? '03' : '02'} · Mensaje (opcional)</legend>
        <label class="tramite-form-field tramite-form-field--full">
          <span class="tramite-form-fieldlabel">Cuéntenos cualquier detalle que ayude a entender el caso</span>
          <textarea name="mensaje" rows={4} placeholder="Plazos, urgencias, antecedentes, etc."></textarea>
        </label>
      </fieldset>

      <!-- Sección: Documentación -->
      <fieldset class="tramite-form-fieldset">
        <legend>{extra.length > 0 ? '04' : '03'} · Documentación</legend>
        <label class="tramite-form-upload">
          <input type="file" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png" />
          <span class="tramite-form-upload-text">
            <strong>↑ Arrastrar documentos o hacer clic para seleccionar</strong>
            <span>PDF, JPG o PNG · hasta 10 MB por archivo</span>
          </span>
          <span class="tramite-form-upload-list" data-file-list></span>
        </label>
      </fieldset>

      <!-- Consentimiento -->
      <label class="tramite-form-consent">
        <input type="checkbox" name="consent" required />
        <span>
          Acepto la política de privacidad y el tratamiento de datos personales
          conforme a la <strong>Ley 25.326</strong>. El envío de este formulario
          no genera por sí mismo relación profesional con el estudio.
        </span>
      </label>

      <!-- Acciones -->
      <div class="tramite-form-actions">
        <span class="tramite-form-secure">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Conexión segura · Confidencialidad profesional
        </span>
        <button type="submit" class="tramite-form-submit">
          Enviar consulta
          <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M1 5h14M11 1l4 4-4 4"/>
          </svg>
        </button>
      </div>

      <!-- Mensaje de estado -->
      <div class="tramite-form-status" data-form-status hidden></div>
    </form>
  </div>
</section>

<script>
  // Hidratación del form: file list preview + submit AJAX a Web3Forms,
  // con fallback a mailto: si la clave no está configurada.
  document.querySelectorAll('form.tramite-form').forEach((form) => {
    const f = form as HTMLFormElement;
    const hasKey = f.dataset.hasKey === 'true';
    const contactEmail = f.dataset.contactEmail || '';
    const status = f.querySelector<HTMLElement>('[data-form-status]')!;
    const fileList = f.querySelector<HTMLElement>('[data-file-list]')!;
    const fileInput = f.querySelector<HTMLInputElement>('input[type=file]')!;
    const submitBtn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;

    // Preview de archivos cargados
    fileInput?.addEventListener('change', () => {
      const files = fileInput.files ? Array.from(fileInput.files) : [];
      if (files.length === 0) { fileList.textContent = ''; return; }
      fileList.innerHTML = files
        .map((f) => `<span class="tramite-form-chip">${f.name} · ${Math.round(f.size / 1024)} KB</span>`)
        .join(' ');
    });

    f.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Fallback mailto cuando Web3Forms no está activado
      if (!hasKey) {
        const fd = new FormData(f);
        const lines: string[] = [];
        for (const [k, v] of fd.entries()) {
          if (k === 'access_key' || k === 'redirect' || k === 'botcheck' || k === 'consent') continue;
          if (v instanceof File) {
            if (v.name) lines.push(`${k}: (adjunto) ${v.name}`);
          } else if (String(v).trim()) {
            lines.push(`${k}: ${v}`);
          }
        }
        const subject = encodeURIComponent(`Nuevo trámite — ${fd.get('tramite_nombre') || ''}`);
        const body = encodeURIComponent(lines.join('\n'));
        window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
        status.hidden = false;
        status.textContent = 'Abrimos su cliente de email con los datos cargados. Por favor adjunte los documentos manualmente y envíe.';
        status.className = 'tramite-form-status tramite-form-status--info';
        return;
      }

      // Submit real a Web3Forms
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';
      status.hidden = false;
      status.textContent = '';

      try {
        const res = await fetch(f.action, { method: 'POST', body: new FormData(f) });
        const data = await res.json();
        if (data.success) {
          status.className = 'tramite-form-status tramite-form-status--ok';
          status.textContent = '✓ Recibimos su consulta. Un abogado del estudio se contactará dentro de las 48 hs hábiles.';
          f.reset();
          fileList.textContent = '';
        } else {
          throw new Error(data.message || 'Error desconocido.');
        }
      } catch (err) {
        status.className = 'tramite-form-status tramite-form-status--error';
        status.textContent = '✗ Hubo un problema al enviar. Intente de nuevo o escríbanos a ' + contactEmail;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Enviar consulta <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 5h14M11 1l4 4-4 4"/></svg>';
      }
    });
  });
</script>

<style>
  .tramite-form-section {
    padding: 4rem 0 6rem;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .tramite-form-label {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--fg-subtle);
    display: block;
    margin-bottom: 0.75rem;
  }
  .tramite-form-title {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 0.6rem;
    line-height: 1.15;
  }
  .tramite-form-sub {
    color: var(--fg-muted);
    margin: 0 0 2.5rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  .tramite-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 920px;
  }
  .tramite-form-fieldset {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--bg);
  }
  .tramite-form-fieldset legend {
    padding: 0 0.6rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--brand-500);
  }
  .tramite-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.25rem;
  }
  @media (max-width: 640px) {
    .tramite-form-grid { grid-template-columns: 1fr; }
  }
  .tramite-form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .tramite-form-field--full { grid-column: 1 / -1; }
  .tramite-form-fieldlabel {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--fg-subtle);
  }
  .tramite-form-fieldlabel em {
    color: var(--brand-500);
    font-style: normal;
    margin-left: 0.2rem;
  }
  .tramite-form input,
  .tramite-form select,
  .tramite-form textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    color: var(--fg);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .tramite-form input:focus,
  .tramite-form select:focus,
  .tramite-form textarea:focus {
    outline: none;
    border-color: var(--brand-500);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-500) 18%, transparent);
  }
  .tramite-form textarea { resize: vertical; min-height: 80px; }

  .tramite-form-upload {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: 1.5px dashed var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    background: color-mix(in srgb, var(--brand-500) 4%, var(--bg));
    cursor: pointer;
    transition: border-color .2s ease, background .2s ease;
  }
  .tramite-form-upload:hover {
    border-color: var(--brand-500);
    background: color-mix(in srgb, var(--brand-500) 7%, var(--bg));
  }
  .tramite-form-upload input[type=file] {
    border: none;
    background: transparent;
    padding: 0;
    font-size: 0.85rem;
  }
  .tramite-form-upload-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
  }
  .tramite-form-upload-text strong {
    font-weight: 600;
    color: var(--fg);
    font-size: 0.95rem;
  }
  .tramite-form-upload-text span {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .tramite-form-upload-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.78rem;
  }
  .tramite-form-chip {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    color: var(--fg-muted);
  }

  .tramite-form-consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--fg-muted);
    padding: 1rem 1.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .tramite-form-consent input[type=checkbox] {
    width: 18px; height: 18px; margin-top: 2px;
    accent-color: var(--brand-500);
  }

  .tramite-form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
    padding-top: 1.5rem;
  }
  .tramite-form-secure {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .tramite-form-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    background: var(--brand-500);
    color: var(--bg);
    border: none;
    border-radius: 6px;
    font-family: 'Montserrat', system-ui;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
  }
  .tramite-form-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--brand-500) 35%, transparent);
  }
  .tramite-form-submit:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
    box-shadow: none;
  }

  .tramite-form-status {
    padding: 0.85rem 1.1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .tramite-form-status--ok {
    background: color-mix(in srgb, #10b981 12%, transparent);
    border: 1px solid color-mix(in srgb, #10b981 35%, transparent);
    color: #047857;
  }
  .tramite-form-status--info {
    background: color-mix(in srgb, var(--brand-500) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-500) 28%, transparent);
    color: var(--fg);
  }
  .tramite-form-status--error {
    background: color-mix(in srgb, #ef4444 10%, transparent);
    border: 1px solid color-mix(in srgb, #ef4444 30%, transparent);
    color: #b91c1c;
  }
</style>
