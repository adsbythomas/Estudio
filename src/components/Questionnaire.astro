---
import type { Practice } from '@lib/site';
import {
  legalQuestions,
  accountingQuestions,
  contacts,
  documentsByRoute,
  responseRoutes,
} from '@lib/questionnaire';

export interface Props {
  practice: Practice;
}

const { practice } = Astro.props;
const questions = practice === 'legal' ? legalQuestions : accountingQuestions;
const firstQuestion = questions.find(q => q.id.endsWith('-start'));
---

<section class="relative overflow-hidden min-h-[80vh] flex items-center py-20" data-questionnaire>
  <div class="shell relative z-10 w-full max-w-2xl mx-auto">
    <div class="questionnaire-container">
      {firstQuestion && (
        <div class="questionnaire-step active" data-step-id={firstQuestion.id}>
          <div class="mb-10 text-center">
            <span class="font-mono text-[0.8rem] md:text-[0.85rem] uppercase tracking-[0.3em] font-medium" style="color: var(--bronze-500)">
              Consulta automatizada
            </span>
            {firstQuestion.description && (
              <p class="mt-3 text-[0.95rem] md:text-[1rem] leading-relaxed" style="color: var(--fg-muted);">
                {firstQuestion.description}
              </p>
            )}
          </div>

          <h2 class="font-sans font-bold leading-[1.15] tracking-tight mb-10 text-center"
              style="font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--fg);">
            {firstQuestion.question}
          </h2>

          <div class="space-y-3 mb-8">
            {firstQuestion.answers.map((answer) => (
              <button
                class="q-answer-btn w-full px-6 py-4 text-left rounded-lg border"
                data-answer-id={answer.id}
              >
                <span class="font-medium text-[0.95rem] md:text-[1rem]">{answer.label}</span>
              </button>
            ))}
          </div>

          <div class="flex items-center gap-2 text-[0.75rem] md:text-[0.8rem]" style="color: var(--fg-muted);">
            <span data-step-indicator>Paso 1</span>
            <div class="flex-1 h-1 rounded-full" style="background: var(--border);"></div>
          </div>
        </div>
      )}

      <div id="questionnaire-steps-container"></div>
      <div id="questionnaire-results" class="questionnaire-step"></div>
    </div>
  </div>
</section>

<style>
  [data-questionnaire] {
    background: var(--bg);
  }

  .questionnaire-step {
    display: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .questionnaire-step.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .q-answer-btn {
    display: block;
    width: 100%;
    background: transparent;
    border-color: var(--border);
    color: var(--fg);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .q-answer-btn:hover {
    border-color: var(--bronze-500);
    color: var(--bronze-500);
    transform: translateX(4px);
  }

  .q-answer-btn:active {
    transform: scale(0.98);
  }

  .q-contact-card {
    background: rgba(128, 128, 128, 0.08);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
</style>

<script define:vars={{ questions, contacts, documentsByRoute, responseRoutes }}>
  (function () {
    // Construir mapa de preguntas
    const questionMap = {};
    questions.forEach((q) => {
      questionMap[q.id] = q;
    });

    const container = document.querySelector('[data-questionnaire]');
    const stepsContainer = document.getElementById('questionnaire-steps-container');
    const resultsContainer = document.getElementById('questionnaire-results');

    if (!container || !stepsContainer || !resultsContainer) {
      console.error('Questionnaire: elementos DOM faltantes');
      return;
    }

    let currentStep = 1;

    function findAnswerById(answerId) {
      for (let i = 0; i < questions.length; i++) {
        const q = questions[i];
        for (let j = 0; j < q.answers.length; j++) {
          if (q.answers[j].id === answerId) return q.answers[j];
        }
      }
      return null;
    }

    function escapeHtml(str) {
      if (str == null) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderQuestion(question) {
      currentStep++;
      const descHtml = question.description
        ? '<p class="text-[0.95rem] md:text-[1rem] leading-relaxed text-center mt-3" style="color: var(--fg-muted);">' +
          escapeHtml(question.description) +
          '</p>'
        : '';

      const answersHtml = question.answers
        .map(function (answer) {
          return (
            '<button class="q-answer-btn w-full px-6 py-4 text-left rounded-lg border" data-answer-id="' +
            escapeHtml(answer.id) +
            '"><span class="font-medium text-[0.95rem] md:text-[1rem]">' +
            escapeHtml(answer.label) +
            '</span></button>'
          );
        })
        .join('');

      const stepHtml =
        '<div class="questionnaire-step" data-step-id="' +
        escapeHtml(question.id) +
        '">' +
        '<div class="mb-10 text-center">' +
        '<span class="font-mono text-[0.8rem] md:text-[0.85rem] uppercase tracking-[0.3em] font-medium" style="color: var(--bronze-500)">Consulta automatizada</span>' +
        descHtml +
        '</div>' +
        '<h2 class="font-sans font-bold leading-[1.15] tracking-tight mb-10 text-center" style="font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--fg);">' +
        escapeHtml(question.question) +
        '</h2>' +
        '<div class="space-y-3 mb-8">' +
        answersHtml +
        '</div>' +
        '<div class="flex items-center gap-2 text-[0.75rem] md:text-[0.8rem]" style="color: var(--fg-muted);">' +
        '<span>Paso ' + currentStep + '</span>' +
        '<div class="flex-1 h-1 rounded-full" style="background: var(--border);"></div>' +
        '</div>' +
        '</div>';

      stepsContainer.insertAdjacentHTML('beforeend', stepHtml);
      const newStep = stepsContainer.querySelector('[data-step-id="' + question.id + '"]');

      // Esconder paso activo actual
      const activeStep = container.querySelector('.questionnaire-step.active');
      if (activeStep) activeStep.classList.remove('active');

      // Activar nuevo paso
      if (newStep) {
        requestAnimationFrame(function () {
          newStep.classList.add('active');
          attachAnswerListeners(newStep);
        });
      }
    }

    function showResults(finalAnswerId) {
      const route = responseRoutes[finalAnswerId];

      if (!route) {
        resultsContainer.innerHTML =
          '<div class="text-center"><h3 class="text-2xl font-bold mb-4" style="color: var(--fg);">Gracias por su respuesta</h3><p style="color: var(--fg-muted);">Contáctenos directamente para una consulta personalizada.</p><a href="#contacto" class="btn-editorial mt-6 inline-block"><span>Ir al formulario</span></a></div>';
        const activeStep = container.querySelector('.questionnaire-step.active');
        if (activeStep) activeStep.classList.remove('active');
        resultsContainer.classList.add('active');
        return;
      }

      const contact = contacts[route.contactKey];
      const allDocs = [];
      route.documents.forEach(function (routeId) {
        if (documentsByRoute[routeId]) {
          allDocs.push.apply(allDocs, documentsByRoute[routeId]);
        }
      });

      const docsHtml = allDocs
        .map(function (doc) {
          const optional = doc.optional
            ? ' <em style="opacity:0.6; font-size:0.8rem;">(opcional)</em>'
            : '';
          return (
            '<li class="flex gap-3 items-start"><span style="color: var(--bronze-500); font-size:1.1rem; line-height:1;">✓</span><div><strong style="color: var(--fg);">' +
            escapeHtml(doc.name) +
            '</strong>' +
            optional +
            '<br/><span style="font-size: 0.85rem; opacity: 0.7;">' +
            escapeHtml(doc.description) +
            '</span></div></li>'
          );
        })
        .join('');

      const contactCardHtml = contact
        ? '<div class="q-contact-card mb-10 text-left">' +
          '<h3 class="font-semibold mb-1 text-lg" style="color: var(--fg);">' +
          escapeHtml(contact.name) +
          '</h3>' +
          '<p class="text-[0.9rem] mb-2" style="color: var(--fg-muted);">' +
          escapeHtml(contact.role) +
          '</p>' +
          '<p class="text-[0.85rem] font-mono uppercase tracking-wider" style="color: var(--bronze-500);">' +
          contact.specialties.map(escapeHtml).join(' · ') +
          '</p>' +
          '</div>'
        : '';

      resultsContainer.innerHTML =
        '<div class="max-w-xl mx-auto">' +
        '<div class="mb-8 text-center">' +
        '<span class="font-mono text-[0.8rem] uppercase tracking-[0.3em] font-medium" style="color: var(--bronze-500);">Resultado</span>' +
        '</div>' +
        '<h2 class="font-sans font-bold leading-[1.15] tracking-tight mb-6 text-center" style="font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--fg);">Hable con ' +
        escapeHtml(contact ? contact.name : 'nuestro equipo') +
        '</h2>' +
        '<p class="text-[0.95rem] md:text-[1rem] leading-relaxed mb-8 text-center" style="color: var(--fg-muted);">' +
        escapeHtml(route.advice) +
        '</p>' +
        contactCardHtml +
        '<div class="mb-10">' +
        '<h4 class="font-semibold mb-4 uppercase tracking-wider text-[0.85rem]" style="color: var(--fg);">Documentos para la primera reunión</h4>' +
        '<ul class="space-y-4">' +
        docsHtml +
        '</ul>' +
        '</div>' +
        '<div class="flex flex-wrap gap-4 justify-center">' +
        '<a href="#contacto" class="btn-editorial"><span>Solicitar consulta</span></a>' +
        '<button type="button" data-restart class="q-answer-btn" style="width:auto; padding:1rem 1.75rem; font-size:0.78rem; font-weight:600; letter-spacing:0.18em; text-transform:uppercase;"><span>Reiniciar</span></button>' +
        '</div>' +
        '</div>';

      const activeStep = container.querySelector('.questionnaire-step.active');
      if (activeStep) activeStep.classList.remove('active');

      requestAnimationFrame(function () {
        resultsContainer.classList.add('active');
        setTimeout(function () {
          resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 200);
      });

      const restartBtn = resultsContainer.querySelector('[data-restart]');
      if (restartBtn) {
        restartBtn.addEventListener('click', function () {
          window.location.reload();
        });
      }
    }

    function handleAnswerClick(btn) {
      const answerId = btn.getAttribute('data-answer-id');
      const answer = findAnswerById(answerId);
      if (!answer) {
        console.error('Questionnaire: respuesta no encontrada', answerId);
        return;
      }

      if (answer.nextStep === 'results' || !answer.nextStep) {
        showResults(answerId);
        return;
      }

      const nextQuestion = questionMap[answer.nextStep];
      if (!nextQuestion) {
        // Si no hay siguiente pregunta definida, mostrar resultados con este answerId
        showResults(answerId);
        return;
      }

      renderQuestion(nextQuestion);
    }

    function attachAnswerListeners(scope) {
      const buttons = scope.querySelectorAll('button[data-answer-id]');
      buttons.forEach(function (btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          handleAnswerClick(btn);
        });
      });
    }

    // Inicializar listeners en el primer paso renderizado por Astro
    const firstStep = container.querySelector('.questionnaire-step.active');
    if (firstStep) {
      attachAnswerListeners(firstStep);
    }
  })();
</script>
