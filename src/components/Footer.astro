---
import { site } from '@lib/site';
import type { Practice } from '@lib/site';

export interface Props { practice: Practice }
const { practice } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
const isoSrc = withBase(practice === 'legal' ? '/brand/isotipo-white.svg' : '/brand/isotipo.svg');
const year = new Date().getFullYear();
---
<footer class="relative border-t overflow-hidden" style="border-color: var(--border)">
  <!-- Banner manifiesto-style: frase grande en serif itálica, full-bleed,
       cierra el sitio con una declaración de identidad. -->
  <div class="footer-manifesto reveal">
    <div class="shell">
      <span class="footer-manifesto-eyebrow">— Pantarotto Lértora</span>
      <p class="footer-manifesto-text">
        Trabajamos para quienes<br/>
        no pueden equivocarse<span class="footer-manifesto-dot">.</span>
      </p>
    </div>
  </div>

  <div class="shell relative z-10 pt-16 md:pt-24 pb-10 md:pb-14">
    <!-- Cierre -->
    <div class="max-w-4xl mb-10 md:mb-16">
      <div class="font-mono text-tick uppercase tracking-tick mb-4 md:mb-5" style="color: var(--brand-600)">El estudio</div>
      <p class="font-serif leading-[1.1]" style="color: var(--fg); font-size: clamp(1.5rem, 5vw, 3.4rem); font-weight: 500;">
        Estudio de abogados<br/>
        con corresponsalías<br/>
        <span style="color: var(--brand-600)">en distintos países.</span>
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-8 md:gap-10 pt-10 md:pt-14 border-t" style="border-color: var(--border)">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <img src={isoSrc} alt="" width="36" height="36" />
          <div class="flex flex-col leading-none">
            <span class="font-sans text-lg font-semibold" style="color: var(--fg)">Pantarotto Lértora</span>
            <span class="font-serif italic text-xs mt-1" style="color: var(--fg-muted)">Legal | Tax Accountants</span>
          </div>
        </div>
        <p class="text-sm leading-relaxed max-w-xs" style="color: var(--fg-muted)">
          Pantarotto · Lértora & Asocs.<br/>
          Abogados & Contadores Públicos
        </p>
      </div>

      <div>
        <h4 class="font-mono text-tick uppercase tracking-tick mb-4" style="color: var(--fg-subtle)">Navegación</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/')} class="transition" style="color: var(--fg-muted)">Área legal</a></li>
          <li><a href={withBase('/contable')} class="transition link-contable">Área contable</a></li>
          <li><a href="#equipo" class="transition" style="color: var(--fg-muted)">Equipo</a></li>
          <li><a href="#historia" class="transition" style="color: var(--fg-muted)">Trayectoria</a></li>
          <li><a href="#contacto" class="transition" style="color: var(--fg-muted)">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-tick uppercase tracking-tick mb-4" style="color: var(--fg-subtle)">Estudio</h4>
        <address class="not-italic text-sm space-y-2" style="color: var(--fg-muted)">
          <div>{site.address.line1}</div>
          <div>{site.address.line2}</div>
          <div>{site.address.postalCode} · Buenos Aires</div>
          <div class="pt-2">{site.hours}</div>
        </address>
      </div>

      <div>
        <h4 class="font-mono text-tick uppercase tracking-tick mb-4" style="color: var(--fg-subtle)">Corresponsalías</h4>
        <ul class="space-y-2 text-sm" style="color: var(--fg-muted)">
          <li>Buenos Aires, AR</li>
          <li>En distintos países</li>
        </ul>
        <a href={site.linkedin} target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 mt-5 text-tick uppercase tracking-tick font-mono transition"
           style="color: var(--fg-muted)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 11.02 5.001 2.5 2.5 0 01-.02-5.001zM3 9h4v12H3zM14.5 9c-2.43 0-3.5 1.5-3.5 3V21h-4V9h4v1.7c.7-.9 2-1.7 3.5-1.7 3 0 4.5 2 4.5 5.2V21h-4v-6.5c0-1.5-.5-2.5-2-2.5z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="mt-10 md:mt-16 pt-6 md:pt-8 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 md:gap-4 text-[0.65rem] md:text-xs font-mono uppercase tracking-tick"
         style="border-color: var(--border); color: var(--fg-subtle)">
      <span>© {year} {site.firmName}</span>
      <span>Buenos Aires · {year}</span>
    </div>
  </div>
</footer>

<style>
  /* ── Banner manifiesto-style arriba del footer ───────────── */
  .footer-manifesto {
    padding: 5rem 0 4rem;
    background: color-mix(in srgb, var(--brand-500) 6%, var(--bg));
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .footer-manifesto { padding: 7rem 0 6rem; }
  }
  /* Línea dorada sutil que aparece de izquierda a derecha al entrar */
  .footer-manifesto::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      color-mix(in srgb, var(--bronze-500) 70%, transparent) 50%,
      transparent 100%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 1.4s cubic-bezier(0.16, 0.84, 0.2, 1);
  }
  .footer-manifesto.in::before { transform: scaleX(1); }

  .footer-manifesto-eyebrow {
    display: block;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--bronze-500);
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .8s cubic-bezier(0.2, 0.7, 0.2, 1) .2s,
                transform .8s cubic-bezier(0.2, 0.7, 0.2, 1) .2s;
  }
  .footer-manifesto.in .footer-manifesto-eyebrow {
    opacity: 1; transform: translateY(0);
  }

  .footer-manifesto-text {
    font-family: 'Lora', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
    max-width: 18ch;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s cubic-bezier(0.2, 0.7, 0.2, 1) .4s,
                transform 1s cubic-bezier(0.2, 0.7, 0.2, 1) .4s;
  }
  .footer-manifesto.in .footer-manifesto-text {
    opacity: 1; transform: translateY(0);
  }
  .footer-manifesto-dot {
    color: var(--bronze-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-manifesto-eyebrow,
    .footer-manifesto-text { opacity: 1; transform: none; transition: none; }
    .footer-manifesto::before { transform: scaleX(1); transition: none; }
  }
</style>
