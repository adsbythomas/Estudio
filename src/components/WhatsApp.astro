---
import { site } from '@lib/site';
import type { Practice } from '@lib/site';
export interface Props { practice: Practice; }
const { practice } = Astro.props;
const msg = practice === 'legal'
  ? 'Hola, me comunico desde el sitio web y quisiera consultar sobre servicios legales.'
  : 'Hola, me comunico desde el sitio web y quisiera consultar sobre servicios contables.';
const href = `https://wa.me/${site.whatsappPhone}?text=${encodeURIComponent(msg)}`;
const previewTitle = practice === 'legal' ? 'Equipo legal' : 'Equipo contable';
---
<!-- Wrapper para el FAB + el preview card. Estado open controlado por
     data-attribute para que CSS y JS lo manipulen. -->
<div class="wa-wrap" data-wa-wrap>
  <!-- Preview card que aparece al primer click. Segundo click abre wa.me -->
  <div class="wa-preview" data-wa-preview role="dialog" aria-labelledby="wa-preview-title">
    <button class="wa-preview-close" data-wa-close aria-label="Cerrar preview">×</button>
    <div class="wa-preview-head">
      <div class="wa-preview-avatar" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      </div>
      <div>
        <div id="wa-preview-title" class="wa-preview-title">{previewTitle}</div>
        <div class="wa-preview-status">
          <span class="wa-preview-dot" aria-hidden="true"></span>
          En línea · lun a vie 9–18 hs
        </div>
      </div>
    </div>
    <p class="wa-preview-msg">
      Hola, ¿en qué te podemos ayudar? Un abogado del estudio te responde
      dentro del horario laboral.
    </p>
    <a href={href} target="_blank" rel="noopener noreferrer" class="wa-preview-cta" data-wa-go>
      Iniciar conversación
      <svg width="14" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 5h14M11 1l4 4-4 4"/></svg>
    </a>
    <span class="wa-preview-foot">Conversación encriptada · WhatsApp</span>
  </div>

  <!-- FAB botón flotante. Tap → abre el preview. Otro tap en CTA → wa.me -->
  <button class="wa-fab" data-wa-toggle aria-label="Consultar por WhatsApp" title="Consultar por WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
  </button>
</div>

<script>
  (() => {
    const wrap   = document.querySelector('[data-wa-wrap]') as HTMLElement | null;
    const toggle = document.querySelector('[data-wa-toggle]') as HTMLElement | null;
    const close  = document.querySelector('[data-wa-close]')  as HTMLElement | null;
    if (!wrap || !toggle) return;
    const setOpen = (v: boolean) => wrap.classList.toggle('open', v);
    toggle.addEventListener('click', () => setOpen(!wrap.classList.contains('open')));
    close?.addEventListener('click', (e) => { e.stopPropagation(); setOpen(false); });
    // Auto-open suave después de 12s la primera vez (sólo desktop, una vez)
    const seen = (() => { try { return localStorage.getItem('plb-wa-seen'); } catch { return null; } })();
    if (!seen && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      setTimeout(() => {
        if (!wrap.classList.contains('open')) {
          setOpen(true);
          try { localStorage.setItem('plb-wa-seen', '1'); } catch {}
        }
      }, 12000);
    }
  })();
</script>

<style>
  .wa-wrap {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 900;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.85rem;
    pointer-events: none;
  }
  .wa-wrap > * { pointer-events: auto; }

  .wa-fab {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    box-shadow: 0 4px 20px rgba(37,211,102,.42);
    transition: transform .22s ease, box-shadow .22s ease;
    cursor: pointer;
  }
  .wa-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(37,211,102,.62);
  }
  .wa-fab svg { width: 1.7rem; height: 1.7rem; }

  /* Preview card — oculta por defecto; visible cuando wrap.open */
  .wa-preview {
    width: min(320px, calc(100vw - 3rem));
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.1rem 1.1rem 1rem;
    box-shadow: 0 20px 48px -16px rgba(0,0,0,.32);
    position: relative;
    transform-origin: bottom right;
    opacity: 0;
    transform: scale(0.85) translateY(12px);
    pointer-events: none;
    transition: opacity .25s cubic-bezier(0.16, 0.84, 0.2, 1),
                transform .35s cubic-bezier(0.16, 0.84, 0.2, 1);
  }
  .wa-wrap.open .wa-preview {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  .wa-preview-close {
    position: absolute;
    top: 0.5rem;
    right: 0.7rem;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--fg-muted);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: background .2s ease, color .2s ease;
  }
  .wa-preview-close:hover {
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    color: var(--fg);
  }

  .wa-preview-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
  }
  .wa-preview-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: grid;
    place-items: center;
    flex: 0 0 40px;
  }
  .wa-preview-title {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--fg);
    line-height: 1.2;
  }
  .wa-preview-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--fg-muted);
    margin-top: 0.2rem;
  }
  .wa-preview-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 0 rgba(37,211,102,.6);
    animation: wa-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes wa-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37,211,102,.45); }
    50%      { box-shadow: 0 0 0 6px rgba(37,211,102,0); }
  }

  .wa-preview-msg {
    background: color-mix(in srgb, var(--fg) 5%, var(--bg));
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.7rem 0.85rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--fg);
    margin: 0 0 1rem;
  }

  .wa-preview-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }
  .wa-preview-cta:hover {
    background: #1ebd5b;
    transform: translateY(-1px);
  }
  .wa-preview-foot {
    display: block;
    text-align: center;
    margin-top: 0.7rem;
    font-family: ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-preview-dot { animation: none; }
    .wa-preview { transition: opacity .15s ease; }
  }
</style>
