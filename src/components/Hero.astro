---
import Obelisco from './Obelisco.astro';
import type { Practice } from '@lib/site';

export interface Props {
  practice: Practice;
  titleLine1: string;
  titleLine2: string;
  lead: string;
  altLabel: string;
  altHref: string;
}
const { practice, titleLine1, titleLine2, lead, altLabel, altHref } = Astro.props;
const kicker = practice === 'legal' ? 'Abogados · Buenos Aires' : 'Contadores Públicos · Buenos Aires';
// Etiqueta del segundo cifrado: "Áreas" en legal, "Servicios" en contable.
const middleStatLabel = practice === 'legal' ? 'Áreas' : 'Servicios';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
---
<section class="relative overflow-hidden flex items-center" data-hero style="min-height: 100svh;">
  <!-- Obelisco decorativo — su altura se ajusta dinámicamente para que el
       extremo superior se alinee con la línea del kicker (Abogados · Buenos
       Aires) y el inferior con la línea de los labels de la faja
       (Jurisdicciones). El SVG escala manteniendo el aspecto 1:3. -->
  <div class="hero-obelisco hidden lg:block absolute right-4 xl:right-12 z-0 pointer-events-none opacity-[0.55]"
       style="color: var(--brand-500);" data-parallax data-parallax-speed="0.15">
    <Obelisco />
  </div>

  <!-- Contenido centrado -->
  <div class="shell relative z-10 py-8 md:py-12 w-full text-center">
    <!-- Tagline con underline -->
    <div class="mb-7 md:mb-9 inline-flex flex-col items-center">
      <span class="font-mono text-[0.75rem] md:text-[0.85rem] uppercase tracking-[0.3em] font-medium"
            style="color: var(--bronze-500)" data-hero-kicker>
        {kicker}
      </span>
      <span class="mt-3 block w-10 h-px" style="background: var(--bronze-500)"></span>
    </div>

    <!-- Título grande en 2 líneas, centrado -->
    <h1 class="font-sans font-bold leading-[1.06] tracking-tight max-w-[950px] mx-auto mb-7"
        style="font-size: clamp(2rem, 4.6vw, 3.6rem); color: var(--fg);">
      <span class="stack-line block" data-stack-line>
        <span class="inline-block">{titleLine1}</span>
      </span>
      <span class="stack-line block" style="--delay: 160" data-stack-line>
        <span class="inline-block"><span style="color: var(--brand-500)">{titleLine2}</span></span>
      </span>
    </h1>

    <!-- Lead -->
    <p class="reveal mx-auto max-w-[700px] text-[0.98rem] md:text-[1.08rem] leading-relaxed mb-8"
       style="color: var(--fg-muted);"
       set:html={lead}>
    </p>

    <!-- CTAs centrados -->
    <div class="reveal flex flex-wrap gap-4 justify-center items-center">
      <a href="#practica" class="btn-hero btn-hero-areas">
        <span>Áreas</span>
      </a>
      <a href={altHref} class="btn-hero btn-hero-accounting">
        <span>{altLabel}</span>
      </a>
    </div>
  </div>

  <!-- Faja de cifras clave — anclada al fondo del hero. Tres números con
       etiqueta corta, separados por líneas finas. Cada `[data-counter]`
       cuenta de 0 al `data-target` cuando el hero entra en viewport. -->
  <div class="hero-stats reveal" aria-label="Cifras clave del estudio">
    <div class="hero-stat">
      <div class="hero-stat-num" data-counter data-target="25"><span data-counter-val>0</span></div>
      <div class="hero-stat-label">Años</div>
    </div>
    <span class="hero-stat-sep" aria-hidden="true"></span>
    <div class="hero-stat">
      <div class="hero-stat-num" data-counter data-target="6"><span data-counter-val>0</span></div>
      <div class="hero-stat-label">{middleStatLabel}</div>
    </div>
    <span class="hero-stat-sep" aria-hidden="true"></span>
    <div class="hero-stat">
      <div class="hero-stat-num" data-counter data-target="3"><span data-counter-val>0</span></div>
      <div class="hero-stat-label">Jurisdicciones</div>
    </div>
  </div>
</section>

<script is:inline>
  // Calcula top/bottom del obelisco para que su extremo superior coincida con
  // la línea del kicker ("Abogados · Buenos Aires") y el inferior con la línea
  // de los labels de la faja ("Jurisdicciones"). Publica variables CSS sobre
  // el <section> del hero.
  (function () {
    const setObelisco = () => {
      const section = document.querySelector('[data-hero]');
      const kicker = document.querySelector('[data-hero-kicker]');
      const stats = document.querySelector('.hero-stats');
      if (!section || !kicker || !stats) return;
      const sRect = section.getBoundingClientRect();
      const kRect = kicker.getBoundingClientRect();
      const stRect = stats.getBoundingClientRect();
      // top: distancia desde el tope de la sección hasta el tope del kicker.
      const top = Math.max(0, kRect.top - sRect.top);
      // bottom: distancia desde el fondo de la sección hasta el fondo de la
      // faja (que es la línea de baseline de los labels).
      const bottom = Math.max(0, sRect.bottom - stRect.bottom);
      section.style.setProperty('--obelisco-top', top + 'px');
      section.style.setProperty('--obelisco-bottom', bottom + 'px');
    };
    setObelisco();
    window.addEventListener('resize', setObelisco);
    window.addEventListener('load', setObelisco);
    // En caso de que las fuentes terminen de cargar después
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setObelisco);
  })();
</script>

<style>
  /* Obelisco — extremo superior alineado con el kicker, extremo inferior
     alineado con la línea de "Jurisdicciones". El SVG llena el alto del
     wrapper manteniendo aspecto 1:3 (ancho derivado). Uso :global() porque
     `.skyline` y `svg` viven en el componente Obelisco — el CSS scoping
     de Astro no los alcanzaría sin esto. */
  .hero-obelisco {
    top: var(--obelisco-top, 22%);
    bottom: var(--obelisco-bottom, 2rem);
    /* aspecto del SVG: 200×600 = 1:3. Fijamos ancho derivado del alto
       disponible para que el wrapper tenga dimensiones explícitas y no
       colapse a 0 en navegadores que no infieren ancho del SVG. */
    aspect-ratio: 1 / 3;
  }
  .hero-obelisco :global(.skyline) {
    height: 100%;
    width: 100%;
    display: block;
  }
  .hero-obelisco :global(svg) {
    height: 100%;
    width: 100%;
    display: block;
  }

  /* Faja de cifras clave — centrada en la base del hero. */
  .hero-stats {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    z-index: 5;
  }
  .hero-stat {
    text-align: center;
    min-width: 88px;
  }
  .hero-stat-num {
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--brand-500);
    letter-spacing: -0.02em;
  }
  .hero-stat-label {
    margin-top: 0.45rem;
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 500;
  }
  .hero-stat-sep {
    display: block;
    width: 1px;
    height: 36px;
    background: var(--border);
    opacity: 0.6;
  }
  @media (max-width: 640px) {
    .hero-stats { gap: 1.4rem; bottom: 1.25rem; }
    .hero-stat-num { font-size: 1.7rem; }
    .hero-stat-label { font-size: 0.6rem; }
    .hero-stat-sep { height: 28px; }
  }

  /* Botones del Hero — sobrios, tamaño cómodo, centrados */
  .btn-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    padding: 1rem 2.25rem;
    font-family: 'Montserrat', Arial, Helvetica, sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: all .45s cubic-bezier(0.2, 0.6, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  /* En mobile reducimos padding y dejamos que cada botón ocupe el ancho
     disponible (flex: 1 1 auto) en lugar del min-width fijo. Así no
     quedan dos botones agigantados en pantallas chicas. */
  @media (max-width: 640px) {
    .btn-hero {
      min-width: 0;
      flex: 1 1 auto;
      padding: 0.85rem 1.25rem;
      font-size: 0.76rem;
      letter-spacing: 0.14em;
    }
  }
  .btn-hero span {
    position: relative;
    z-index: 1;
  }
  .btn-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translateX(-101%);
    transition: transform .45s cubic-bezier(0.2, 0.6, 0.2, 1);
    z-index: 0;
  }
  .btn-hero:hover::before {
    transform: translateX(0);
  }

  /* Áreas — usa el color principal del área activa (legal=slate / contable=bronze) */
  .btn-hero-areas {
    color: var(--brand-500);
    background: transparent;
    border: 1.5px solid var(--brand-500);
  }
  .btn-hero-areas::before {
    background: var(--brand-500);
  }
  .btn-hero-areas:hover {
    color: var(--bg);
  }

  /* Botón cross-link entre áreas — en tema legal apunta a contable y usa el color
     de fondo de la página contable (Ice Grey #e9e9f2). En tema contable apunta a
     legal y usa el navy (color principal del área contable como acento). */
  .btn-hero-accounting {
    color: #e9e9f2;
    background: transparent;
    border: 1.5px solid #e9e9f2;
  }
  .btn-hero-accounting::before {
    background: #e9e9f2;
  }
  .btn-hero-accounting:hover {
    color: #242b42;
    border-color: #e9e9f2;
  }
  /* En tema contable (fondo ice grey) el botón apunta a legal: color navy. */
  :global(.theme-accounting) .btn-hero-accounting {
    color: #242b42;
    background: transparent;
    border-color: #242b42;
  }
  :global(.theme-accounting) .btn-hero-accounting::before {
    background: #242b42;
  }
  :global(.theme-accounting) .btn-hero-accounting:hover {
    color: #e9e9f2;
    border-color: #242b42;
  }
</style>
