---
import Obelisco from './Obelisco.astro';
import type { Practice } from '@lib/site';

export interface Props {
  practice: Practice;
  titleLine1: string;
  titleLine2: string;
  lead: string;
  ctaPrimary: string;
  altLabel: string;
  altHref: string;
}
const { practice, titleLine1, titleLine2, lead, ctaPrimary, altLabel, altHref } = Astro.props;
const kicker = practice === 'legal' ? 'Abogados · Buenos Aires' : 'Contadores Públicos · Buenos Aires';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
const isoSrc = withBase(practice === 'legal' ? '/brand/isotipo-white.svg' : '/brand/isotipo.svg');
const questionnairePath = practice === 'legal' ? withBase('/automatizacion') : withBase('/automatizacion-contable');
const questionnaireLabel = practice === 'legal' ? 'Responda nuestro cuestionario' : 'Responda nuestro cuestionario';
---
<section class="relative overflow-hidden flex items-center" data-hero style="min-height: calc(100svh - 4rem);">
  <!-- Obelisco decorativo único, a la derecha -->
  <div class="hidden lg:block absolute right-6 xl:right-16 top-1/2 -translate-y-1/2 z-0 w-[90px] xl:w-[110px] pointer-events-none opacity-[0.4]"
       style="color: var(--brand-500);" data-parallax data-parallax-speed="0.15">
    <Obelisco />
  </div>

  <!-- Contenido centrado -->
  <div class="shell relative z-10 py-10 md:py-14 w-full text-center">
    <!-- Isotipo (sin wordmark duplicado — ya está en el nav) -->
    <div class="mb-5 flex justify-center">
      <img src={isoSrc} alt="Pantarotto Lértora Bardagí" width="64" height="64" />
    </div>

    <!-- Tagline con underline -->
    <div class="mb-8 md:mb-10 inline-flex flex-col items-center">
      <span class="font-mono text-[0.72rem] md:text-[0.82rem] uppercase tracking-[0.3em] font-medium"
            style="color: var(--bronze-500)">
        {kicker}
      </span>
      <span class="mt-3 block w-10 h-px" style="background: var(--bronze-500)"></span>
    </div>

    <!-- Título grande en 2 líneas, centrado -->
    <h1 class="font-sans font-bold leading-[1.08] tracking-tight max-w-[900px] mx-auto mb-7"
        style="font-size: clamp(1.9rem, 4.6vw, 3.4rem); color: var(--fg);">
      <span class="stack-line block" data-stack-line>
        <span class="inline-block">{titleLine1}</span>
      </span>
      <span class="stack-line block" style="--delay: 160" data-stack-line>
        <span class="inline-block"><span style="color: var(--brand-500)">{titleLine2}</span></span>
      </span>
    </h1>

    <!-- Lead -->
    <p class="reveal mx-auto max-w-[680px] text-[0.95rem] md:text-[1.02rem] leading-relaxed mb-8"
       style="color: var(--fg-muted);">
      {lead}
    </p>

    <!-- CTAs -->
    <div class="reveal inline-flex flex-wrap gap-3 justify-center items-center">
      <a href="#contacto" class="btn-editorial">
        <span>{ctaPrimary}</span>
      </a>
      <a href={questionnairePath} class="btn-questionnaire">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>{questionnaireLabel}</span>
      </a>
    </div>

    <!-- Link secundario a la otra área -->
    <div class="reveal mt-6">
      <a href={altHref} class={`font-mono text-tick uppercase tracking-tick transition inline-flex items-center gap-2 ${practice === 'legal' ? 'link-accounting' : ''}`}
         style={practice === 'legal' ? '' : 'color: var(--fg-subtle);'}>
        {altLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    transition: all .4s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .btn-outline:hover {
    border-color: var(--brand-500);
    color: var(--brand-400);
  }

  /* Botón distintivo para el cuestionario — acento bronce */
  .btn-questionnaire {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bronze-500);
    background: transparent;
    border: 1.5px solid var(--bronze-500);
    border-radius: 2px;
    transition: all .4s cubic-bezier(0.2, 0.6, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .btn-questionnaire::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bronze-500);
    transform: translateX(-100%);
    transition: transform .4s cubic-bezier(0.2, 0.6, 0.2, 1);
    z-index: 0;
  }
  .btn-questionnaire:hover::before {
    transform: translateX(0);
  }
  .btn-questionnaire:hover {
    color: var(--bg);
  }
  .btn-questionnaire svg,
  .btn-questionnaire span {
    position: relative;
    z-index: 1;
  }
</style>
