---
/**
 * Sección "Método" — cómo trabaja el estudio en 4 pasos.
 *
 * Pieza editorial entre Manifiesto y CrossLink. Da la trazabilidad
 * del proceso (algo que un cliente quiere ver antes de levantar el
 * teléfono). Cada paso con número grande serif, título y descripción
 * breve. Animación de avance de la línea horizontal al entrar en
 * viewport (efecto "diagrama que se dibuja").
 */
const pasos = [
  {
    num: '01',
    titulo: 'Consulta inicial',
    desc: 'Un primer encuentro confidencial, sin compromiso, para entender el caso y evaluar si lo podemos asistir.',
  },
  {
    num: '02',
    titulo: 'Propuesta y plazos',
    desc: 'Hoja de ruta concreta con alcance, plazos y honorarios definidos. Sin sorpresas durante el desarrollo del caso.',
  },
  {
    num: '03',
    titulo: 'Asignación de equipo',
    desc: 'Un socio responsable y los abogados o contadores que correspondan según la complejidad y las áreas involucradas.',
  },
  {
    num: '04',
    titulo: 'Ejecución y cierre',
    desc: 'Avance reportado en plazos definidos, comunicación clara en cada hito y entregables firmes al cerrar el expediente.',
  },
];
---
<section id="metodo" class="metodo reveal" aria-labelledby="metodo-title">
  <div class="shell">
    <header class="metodo-head">
      <div class="metodo-label">
        <span class="metodo-num">— 03</span>
        <span class="metodo-kicker">Método</span>
      </div>
      <h2 id="metodo-title" class="metodo-title">
        Cómo trabajamos<span style="color: var(--brand-500)">.</span>
      </h2>
      <p class="metodo-sub">
        Cuatro etapas claras del primer contacto al cierre del expediente.
        El cliente sabe en cada momento quién lleva su caso y cuándo se le
        responde.
      </p>
    </header>

    <ol class="metodo-grid">
      {pasos.map((p, i) => (
        <li class="metodo-step reveal" style={`--step-i: ${i};`}>
          <div class="metodo-step-num" aria-hidden="true">{p.num}</div>
          <div class="metodo-step-title">{p.titulo}</div>
          <p class="metodo-step-desc">{p.desc}</p>
          {i < pasos.length - 1 && <span class="metodo-step-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodo {
    padding: 5rem 0 6rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .metodo { padding: 7rem 0 8rem; }
  }

  .metodo-head {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .metodo-head { margin-bottom: 5rem; }
  }
  .metodo-label {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .metodo-num {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--bronze-500);
    letter-spacing: 0.04em;
  }
  .metodo-kicker {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    font-weight: 700;
  }
  .metodo-title {
    font-family: 'Lora', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 1.5rem;
  }
  .metodo-sub {
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 56ch;
    margin: 0;
  }

  /* Grid de 4 pasos horizontal en desktop, vertical en mobile */
  .metodo-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .metodo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
      position: relative;
    }
    /* Línea horizontal sutil que conecta los 4 pasos detrás de los números.
       Se dibuja de izquierda a derecha cuando la sección entra en viewport. */
    .metodo-grid::before {
      content: '';
      position: absolute;
      top: 28px;
      left: 6%;
      right: 6%;
      height: 1px;
      background: linear-gradient(to right,
        transparent 0%,
        color-mix(in srgb, var(--bronze-500) 60%, transparent) 10%,
        color-mix(in srgb, var(--bronze-500) 60%, transparent) 90%,
        transparent 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 1.4s cubic-bezier(0.16, 0.84, 0.2, 1);
    }
    .metodo.in .metodo-grid::before {
      transform: scaleX(1);
    }
  }

  .metodo-step {
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .7s cubic-bezier(0.2, 0.7, 0.2, 1),
                transform .7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--step-i, 0) * 130ms + 200ms);
  }
  .metodo-step.in {
    opacity: 1;
    transform: translateY(0);
  }
  .metodo-step-num {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    line-height: 1;
    color: var(--brand-500);
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    /* Un círculo de fondo blanco/fg para que el número "ocluya" la línea
       que está detrás (efecto cleaner del diagrama). */
    width: 56px;
    height: 56px;
    display: inline-grid;
    place-items: center;
    background: var(--bg);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--bronze-500) 35%, var(--border));
  }
  .metodo-step-title {
    font-family: 'Montserrat', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin-bottom: 0.6rem;
  }
  .metodo-step-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
    max-width: 28ch;
  }
  .metodo-step-arrow {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .metodo-step       { opacity: 1; transform: none; transition: none; }
    .metodo-grid::before { transform: scaleX(1); transition: none; }
  }
</style>
