---
import { site } from '@lib/site';
import type { Practice } from '@lib/site';
import LangToggle from '@components/LangToggle.astro';
import Search from '@components/Search.astro';

export interface Props {
  practice: Practice;
  /** Si la página actual contiene los anchors (#practica, #equipo, etc).
   *  En subpáginas (ej. /vencimientos) los anchors apuntan a la landing correcta. */
  landing?: boolean;
}
const { practice, landing = true } = Astro.props;
const isLegal = practice === 'legal';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

// Prefijo para los anchors. Si estamos en la landing, vacío (anchor local).
// Si no, va a la landing correspondiente al practice del nav.
const anchorBase = landing ? '' : withBase(isLegal ? '/' : '/contable');

// "Vencimientos" (calendario ARCA) sólo aparece en el área contable —
// el área legal no tiene calendario de vencimientos.
const navLinks = [
  { href: anchorBase + '#practica',         label: 'Práctica' },
  { href: anchorBase + '#equipo',           label: 'Equipo' },
  ...(isLegal ? [] : [{ href: withBase('/vencimientos'), label: 'Vencimientos' }]),
  { href: anchorBase + '#contacto',         label: 'Contacto' },
];
const altHref = isLegal ? withBase('/contable') : withBase('/');
const altLabel = isLegal ? '→ Contable' : '→ Legal';
// Isotipo invertido según tema: legal (fondo navy) → blanco; contable (fondo ice) → navy.
const isoSrc = withBase(isLegal ? '/brand/isotipo-white.svg' : '/brand/isotipo.svg');
---
<div class="scroll-progress" id="scrollProgress"></div>

<nav id="mainNav" class="fixed inset-x-0 top-0 z-50 transition-all duration-500" data-nav>
  <div class="shell h-20 md:h-28 flex items-center justify-between">
    <div class="flex items-center gap-4 md:gap-6">
      <LangToggle />
    <a href={withBase('/')} class="flex items-center gap-3 group" aria-label="Inicio">
      <img src={isoSrc} alt="" width="38" height="38" class="brand-iso" />
      <span class="flex flex-col leading-none">
        <span class="brand-mark font-sans text-[1.1rem] md:text-[1.25rem] font-semibold tracking-tight">
          Pantarotto Lértora
        </span>
        <span class="brand-tick hidden md:inline font-mono text-[0.66rem] uppercase tracking-[0.24em] mt-1.5">Legal | Tax Accountants</span>
      </span>
    </a>
    </div>

    <ul class="hidden md:flex items-center gap-7 text-[0.95rem]">
      {navLinks.map((l) => (
        <li><a href={l.href} class="nav-link">{l.label}</a></li>
      ))}
      <li><Search /></li>
      <li>
        <a href={altHref} class="nav-link font-mono link-accounting">{altLabel}</a>
      </li>
    </ul>

    <button id="mob-open" class="md:hidden w-10 h-10 grid place-items-center" aria-label="Abrir menú">
      <svg width="22" height="14" viewBox="0 0 22 14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1h20M1 7h14M1 13h18"/></svg>
    </button>
  </div>
</nav>

<div id="mob" class="fixed inset-0 z-[60] hidden flex-col" style="background: var(--bg); color: var(--fg);">
  <div class="shell h-16 flex justify-between items-center">
    <div class="flex items-center gap-2">
      <img src={isoSrc} alt="" width="24" height="24" />
      <span class="font-sans text-[1rem] font-semibold">Pantarotto Lértora</span>
    </div>
    <button id="mob-close" aria-label="Cerrar" class="text-3xl leading-none" style="color: var(--fg-muted);">×</button>
  </div>
  <nav class="shell flex-1 flex flex-col justify-center gap-6">
    {navLinks.map((l, i) => (
      <a href={l.href} class="font-sans text-4xl font-semibold transition" style={`transition-delay: ${i * 60}ms; color: var(--fg);`}>
        <span class="font-mono text-tick tracking-tick mr-5" style="color: var(--brand-600)">0{i + 1}</span>{l.label}
      </a>
    ))}
    <a href={altHref} class="mt-8 font-mono text-tick tracking-tick uppercase w-fit link-accounting">{altLabel}</a>
  </nav>
</div>

<style>
  #mob.open { display: flex; }
  /* El nav solid adopta el fondo del tema actual (sin blur, que era
     el principal culpable de jank en mobile/Safari). Fondo opaco del
     tema y borde inferior sutil. */
  nav[data-nav].solid {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
</style>
