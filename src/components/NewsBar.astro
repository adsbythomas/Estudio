---
// Franja de novedades sobre el nav (sólo área legal): muestra la última
// publicación/novedad y un acceso directo al radar normativo.
import { legalRadar } from '@lib/news';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

const latest = legalRadar.items[0];
---
{latest && (
  <div class="newsbar">
    <div class="shell newsbar-inner">
      <a href={withBase(`/novedades/${latest.slug}`)} class="newsbar-item">
        <span class="newsbar-badge">
          <span class="newsbar-dot" aria-hidden="true"></span>
          Nuevo
        </span>
        <span class="newsbar-title">{latest.title}</span>
      </a>
      <a href={withBase('/novedades')} class="newsbar-all">
        <span class="hidden sm:inline">Radar normativo</span>
        <span class="sm:hidden">Novedades</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
)}

<style>
  .newsbar {
    background: #e9e9f2;
    color: #242b42;
    border-bottom: 1px solid rgba(36, 43, 66, 0.15);
  }
  .newsbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
  }
  .newsbar-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.45rem 0;
  }
  .newsbar-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.6rem;
    background: #455a89;
    color: #fff;
    border-radius: 999px;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .newsbar-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
  }
  .newsbar-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    animation: newsbar-pulse 1.8s ease-out infinite;
  }
  @keyframes newsbar-pulse {
    from { transform: scale(1); opacity: 0.8; }
    to   { transform: scale(3); opacity: 0; }
  }
  .newsbar-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .newsbar-item:hover .newsbar-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .newsbar-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Montserrat', system-ui, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #455a89;
    transition: color .25s ease;
  }
  .newsbar-all:hover { color: #242b42; }

  @media (prefers-reduced-motion: reduce) {
    .newsbar-dot::after { animation: none; }
  }
</style>
