---
import { vencimientos2026 } from '@lib/vencimientos';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

const allData = JSON.stringify(vencimientos2026);
const linkHref = withBase('/vencimientos');
---
<section class="ven-prev" aria-labelledby="ven-prev-title">
  <div class="shell py-16 md:py-20">
    <div class="ven-prev-head reveal">
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.28em] font-semibold" style="color: var(--brand-500)">
        Próximos vencimientos
      </span>
      <h2 id="ven-prev-title" class="font-sans font-bold mt-3"
          style="font-size: clamp(1.5rem, 3vw, 2.2rem); color: var(--fg); letter-spacing: -0.01em;">
        Calendario AFIP <span style="color: var(--brand-500)">en vivo</span>
      </h2>
      <p class="mt-3 max-w-[520px] text-[0.92rem] leading-relaxed" style="color: var(--fg-muted);">
        Tu agenda fiscal de las próximas semanas. Hacé clic en "Ver calendario completo" para explorar el año entero.
      </p>
    </div>

    <div id="ven-prev-list" class="ven-prev-list reveal" data-no-translate>
      <div class="ven-prev-loading">Cargando vencimientos…</div>
    </div>

    <div class="ven-prev-cta reveal">
      <a href={linkHref} class="ven-prev-link">
        Ver calendario completo
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ allData }}>
  (function () {
    var data = JSON.parse(allData);
    var MONTHS_LONG = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var DAYS_LONG   = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    var CAT_LABEL    = { monotributo: 'Monotributo', ri: 'Resp. Inscripto', sociedades: 'Sociedades' };

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function parseDate(s) {
      var p = s.split('-');
      return new Date(+p[0], +p[1] - 1, +p[2]);
    }

    function barClass(cats) {
      if (cats.indexOf('monotributo') >= 0 && cats.length === 1) return 'agenda-bar--mt';
      if (cats.indexOf('sociedades') >= 0)                       return 'agenda-bar--soc';
      if (cats.indexOf('ri') >= 0)                               return 'agenda-bar--ri';
      return 'agenda-bar--mt';
    }

    var upcoming = data
      .filter(function (v) { return parseDate(v.date) >= today; })
      .sort(function (a, b) { return a.date.localeCompare(b.date); })
      .slice(0, 5);

    if (upcoming.length === 0) {
      document.getElementById('ven-prev-list').innerHTML =
        '<p class="ven-prev-empty">Sin vencimientos próximos en el calendario cargado.</p>';
      return;
    }

    function diffDays(d) { return Math.round((d - today) / 86400000); }

    var html = '';
    var lastDateKey = '';

    upcoming.forEach(function (v) {
      var d = parseDate(v.date);
      var diff = diffDays(d);
      var diffLabel = diff === 0 ? 'Hoy' : (diff === 1 ? 'Mañana' : 'En ' + diff + ' días');
      var urgent = diff <= 7;
      var cats = v.categories.map(function (c) { return CAT_LABEL[c] || c; }).join(' · ');
      var dateKey = v.date;

      // Encabezado de fecha (solo cuando cambia)
      if (dateKey !== lastDateKey) {
        html += '<div class="agenda-day-header">';
        html += '<span class="agenda-day-num">' + d.getDate() + '</span>';
        html += '<div class="agenda-day-info">';
        html += '<span class="agenda-day-name">' + DAYS_LONG[d.getDay()] + '</span>';
        html += '<span class="agenda-day-month">' + MONTHS_LONG[d.getMonth()] + ' ' + d.getFullYear() + '</span>';
        html += '</div>';
        html += '<span class="agenda-day-diff' + (urgent ? ' agenda-day-diff--urgent' : '') + '">' + diffLabel + '</span>';
        html += '</div>';
        lastDateKey = dateKey;
      }

      html += '<div class="agenda-item">';
      html += '<span class="agenda-bar ' + barClass(v.categories) + '" aria-hidden="true"></span>';
      html += '<div class="agenda-body">';
      html += '<h3 class="agenda-title">' + v.label + '</h3>';
      html += '<p class="agenda-detail">' + v.detail + '</p>';
      html += '<span class="agenda-cats">' + cats + '</span>';
      html += '</div>';
      html += '</div>';
    });

    document.getElementById('ven-prev-list').innerHTML = html;
  })();
</script>

<style>
  .ven-prev {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .ven-prev-head { margin-bottom: 2.5rem; }

  /* Agenda — Google Calendar style */
  .ven-prev-list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .ven-prev-loading,
  .ven-prev-empty {
    color: var(--fg-muted);
    font-size: 0.88rem;
    padding: 1.5rem 0;
    font-style: italic;
    text-align: center;
  }

  /* Encabezado de cada día */
  .agenda-day-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0 0.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }
  .agenda-day-header:first-child { padding-top: 0.5rem; }

  .agenda-day-num {
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
    letter-spacing: -0.02em;
    min-width: 2.4rem;
    text-align: center;
  }
  .agenda-day-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .agenda-day-name {
    font-family: var(--font-sans, system-ui);
    font-size: 1.05rem;
    color: var(--fg);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.005em;
  }
  .agenda-day-month {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-500);
    font-weight: 700;
    margin-top: 0.2rem;
  }
  .agenda-day-diff {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }
  .agenda-day-diff--urgent {
    color: #f59e0b;
    border-color: #f59e0b;
    background: color-mix(in srgb, #f59e0b 8%, transparent);
  }

  /* Item del evento */
  .agenda-item {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-left: 3.4rem; /* alineado con el ancho del día + gap */
    margin-bottom: 0.4rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    transition: all .2s ease;
  }
  .agenda-item:hover {
    box-shadow: 0 2px 12px color-mix(in srgb, var(--fg) 8%, transparent);
    border-color: color-mix(in srgb, var(--brand-500) 40%, var(--border));
  }

  .agenda-bar {
    width: 4px;
    flex-shrink: 0;
    background: var(--brand-500);
  }
  .agenda-bar--mt  { background: #f59e0b; }
  .agenda-bar--ri  { background: var(--brand-500); }
  .agenda-bar--soc { background: #8b5cf6; }

  .agenda-body {
    flex: 1;
    min-width: 0;
    padding: 0.85rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .agenda-title {
    font-family: var(--font-sans, system-ui);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .agenda-detail {
    font-size: 0.78rem;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.45;
  }
  .agenda-cats {
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    opacity: 0.7;
    font-weight: 600;
    margin-top: 0.1rem;
  }

  @media (max-width: 540px) {
    .agenda-item { margin-left: 0; }
    .agenda-day-num { font-size: 2rem; min-width: 2rem; }
  }

  /* CTA */
  .ven-prev-cta {
    margin-top: 2.5rem;
    text-align: center;
  }
  .ven-prev-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--brand-500);
    padding: 0.6rem 1.2rem;
    border: 1.5px solid var(--brand-500);
    border-radius: 3px;
    transition: all .2s ease;
  }
  .ven-prev-link:hover {
    background: var(--brand-500);
    color: var(--bg);
  }
  .ven-prev-link span { transition: transform .2s ease; }
  .ven-prev-link:hover span { transform: translateX(3px); }
</style>
