---
import { vencimientos2026 } from '@lib/vencimientos';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

const allData = JSON.stringify(vencimientos2026);
const linkHref = withBase('/vencimientos');
---
<section class="ven-prev" aria-labelledby="ven-prev-title">
  <div class="shell py-16 md:py-20">
    <div class="ven-prev-head reveal">
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.28em] font-semibold" style="color: var(--brand-500)">
        Próximos vencimientos
      </span>
      <h2 id="ven-prev-title" class="font-sans font-bold mt-3"
          style="font-size: clamp(1.5rem, 3vw, 2.2rem); color: var(--fg); letter-spacing: -0.01em;">
        Calendario AFIP <span style="color: var(--brand-500)">en vivo</span>
      </h2>
      <p class="mt-3 max-w-[520px] text-[0.92rem] leading-relaxed" style="color: var(--fg-muted);">
        Tu agenda fiscal de las próximas semanas. Hacé clic en "Ver calendario completo" para explorar el año entero.
      </p>
    </div>

    <div id="ven-prev-list" class="ven-prev-list reveal" data-no-translate>
      <div class="ven-prev-loading">Cargando vencimientos…</div>
    </div>

    <div class="ven-prev-cta reveal">
      <a href={linkHref} class="ven-prev-link">
        Ver calendario completo
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ allData }}>
  (function () {
    var data = JSON.parse(allData);
    var MONTHS_LONG = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    var DAYS_LONG   = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    var CAT_LABEL   = { monotributo: 'Monotributo', ri: 'Resp. Inscripto', sociedades: 'Sociedades' };

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function parseDate(s) {
      var p = s.split('-');
      return new Date(+p[0], +p[1] - 1, +p[2]);
    }

    function dotClass(cats) {
      if (cats.indexOf('monotributo') >= 0 && cats.length === 1) return 'cal-card-dot--mt';
      if (cats.indexOf('sociedades') >= 0)                       return 'cal-card-dot--soc';
      if (cats.indexOf('ri') >= 0)                               return 'cal-card-dot--ri';
      return 'cal-card-dot--mt';
    }

    var upcoming = data
      .filter(function (v) { return parseDate(v.date) >= today; })
      .sort(function (a, b) { return a.date.localeCompare(b.date); })
      .slice(0, 4);

    if (upcoming.length === 0) {
      document.getElementById('ven-prev-list').innerHTML =
        '<p class="ven-prev-empty">Sin vencimientos próximos en el calendario cargado.</p>';
      return;
    }

    function diffDays(d) { return Math.round((d - today) / 86400000); }

    var html = '';
    upcoming.forEach(function (v) {
      var d = parseDate(v.date);
      var diff = diffDays(d);
      var diffLabel = diff === 0 ? 'Hoy' : (diff === 1 ? 'Mañana' : 'En ' + diff + ' días');
      var urgent = diff <= 7;
      var cats = v.categories.map(function (c) { return CAT_LABEL[c] || c; }).join(' · ');

      html += '<article class="cal-card' + (urgent ? ' cal-card--urgent' : '') + '">';

      // Header — Mes Año
      html += '<header class="cal-card-header">';
      html += '<span class="cal-card-month">' + MONTHS_LONG[d.getMonth()] + ' ' + d.getFullYear() + '</span>';
      html += '</header>';

      // Hoja de día — número grande + nombre del día
      html += '<div class="cal-card-page">';
      html += '<span class="cal-card-num">' + d.getDate() + '</span>';
      html += '<span class="cal-card-dow">' + DAYS_LONG[d.getDay()] + '</span>';
      html += '</div>';

      // Pie — Evento
      html += '<footer class="cal-card-event">';
      html += '<div class="cal-card-cats-row">';
      html += '<span class="cal-card-dot ' + dotClass(v.categories) + '" aria-hidden="true"></span>';
      html += '<span class="cal-card-cats">' + cats + '</span>';
      html += '</div>';
      html += '<h3 class="cal-card-title">' + v.label + '</h3>';
      html += '<span class="cal-card-diff' + (urgent ? ' cal-card-diff--urgent' : '') + '">' + diffLabel + '</span>';
      html += '</footer>';

      html += '</article>';
    });

    document.getElementById('ven-prev-list').innerHTML = html;
  })();
</script>

<style>
  .ven-prev {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .ven-prev-head { margin-bottom: 2.5rem; }

  .ven-prev-list {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .ven-prev-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .ven-prev-list { grid-template-columns: repeat(4, 1fr); }
  }

  .ven-prev-loading,
  .ven-prev-empty {
    color: var(--fg-muted);
    font-size: 0.88rem;
    padding: 1.5rem 0;
    font-style: italic;
    text-align: center;
    grid-column: 1 / -1;
  }

  /* ── Tarjeta tipo hoja de calendario ── */
  .cal-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--fg) 4%, transparent);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .cal-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--fg) 10%, transparent);
    border-color: color-mix(in srgb, var(--brand-500) 50%, var(--border));
  }
  .cal-card--urgent { border-top: 3px solid #f59e0b; }

  /* Header — banda con el mes */
  .cal-card-header {
    background: var(--brand-500);
    padding: 0.55rem 0.75rem;
    text-align: center;
  }
  .cal-card-month {
    display: block;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--bg);
  }

  /* Hoja del día — número grande + nombre */
  .cal-card-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem 1.4rem;
    border-bottom: 1px dashed var(--border);
    background: color-mix(in srgb, var(--fg) 1.5%, var(--bg));
  }
  .cal-card-num {
    font-family: var(--font-sans, system-ui);
    font-size: 3.6rem;
    font-weight: 200;
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.4rem;
  }
  .cal-card-dow {
    font-family: var(--font-sans, system-ui);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  /* Evento — pie de la tarjeta */
  .cal-card-event {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .cal-card-cats-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cal-card-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cal-card-dot--mt  { background: #f59e0b; }
  .cal-card-dot--ri  { background: var(--brand-500); }
  .cal-card-dot--soc { background: #8b5cf6; }
  .cal-card-cats {
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 700;
  }
  .cal-card-title {
    font-family: var(--font-sans, system-ui);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .cal-card-diff {
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 700;
  }
  .cal-card-diff--urgent { color: #f59e0b; }

  /* CTA */
  .ven-prev-cta {
    margin-top: 2.5rem;
    text-align: center;
  }
  .ven-prev-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--brand-500);
    padding: 0.6rem 1.2rem;
    border: 1.5px solid var(--brand-500);
    border-radius: 3px;
    transition: all .2s ease;
  }
  .ven-prev-link:hover {
    background: var(--brand-500);
    color: var(--bg);
  }
  .ven-prev-link span { transition: transform .2s ease; }
  .ven-prev-link:hover span { transform: translateX(3px); }
</style>
