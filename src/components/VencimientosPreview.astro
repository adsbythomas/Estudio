---
import { vencimientos2026 } from '@lib/vencimientos';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;

const allData = JSON.stringify(vencimientos2026);
const linkHref = withBase('/vencimientos');
---
<section class="ven-prev" aria-labelledby="ven-prev-title">
  <div class="shell py-16 md:py-20">
    <div class="ven-prev-head reveal">
      <span class="font-mono text-[0.7rem] uppercase tracking-[0.28em] font-semibold" style="color: var(--brand-500)">
        Próximos vencimientos
      </span>
      <h2 id="ven-prev-title" class="font-sans font-bold mt-3"
          style="font-size: clamp(1.5rem, 3vw, 2.2rem); color: var(--fg); letter-spacing: -0.01em;">
        Calendario AFIP <span style="color: var(--brand-500)">en vivo</span>
      </h2>
      <p class="mt-3 max-w-[520px] text-[0.92rem] leading-relaxed" style="color: var(--fg-muted);">
        Los próximos cinco vencimientos impositivos. Hacé clic para ver el calendario completo del año.
      </p>
    </div>

    <div id="ven-prev-list" class="ven-prev-list reveal" data-no-translate>
      <!-- Renderizado por JS -->
      <div class="ven-prev-loading">Cargando vencimientos…</div>
    </div>

    <div class="ven-prev-cta reveal">
      <a href={linkHref} class="ven-prev-link">
        Ver calendario completo
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ allData }}>
  (function () {
    var data = JSON.parse(allData);
    var MONTHS_SHORT = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
    var DAYS_SHORT   = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
    var CAT_LABEL    = { monotributo: 'Monotributo', ri: 'Resp. Inscripto', sociedades: 'Sociedades' };

    var today = new Date();
    today.setHours(0, 0, 0, 0);

    function parseDate(s) {
      var p = s.split('-');
      return new Date(+p[0], +p[1] - 1, +p[2]);
    }

    var upcoming = data
      .filter(function (v) { return parseDate(v.date) >= today; })
      .sort(function (a, b) { return a.date.localeCompare(b.date); })
      .slice(0, 5);

    if (upcoming.length === 0) {
      document.getElementById('ven-prev-list').innerHTML =
        '<p class="ven-prev-empty">Sin vencimientos próximos en el calendario cargado.</p>';
      return;
    }

    function diffDays(d) {
      return Math.round((d - today) / 86400000);
    }

    var html = '';
    upcoming.forEach(function (v) {
      var d = parseDate(v.date);
      var diff = diffDays(d);
      var diffLabel = diff === 0 ? 'Hoy' : (diff === 1 ? 'Mañana' : 'En ' + diff + ' días');
      var urgent = diff <= 7;
      var cats = v.categories.map(function (c) { return CAT_LABEL[c] || c; }).join(' · ');

      html += '<div class="ven-prev-item' + (urgent ? ' ven-prev-item--urgent' : '') + '">';
      html += '<div class="ven-prev-date">';
      html += '<span class="ven-prev-day">' + d.getDate() + '</span>';
      html += '<span class="ven-prev-month">' + MONTHS_SHORT[d.getMonth()] + '</span>';
      html += '<span class="ven-prev-dow">' + DAYS_SHORT[d.getDay()] + '</span>';
      html += '</div>';
      html += '<div class="ven-prev-body">';
      html += '<span class="ven-prev-cats">' + cats + '</span>';
      html += '<h3 class="ven-prev-label">' + v.label + '</h3>';
      html += '<span class="ven-prev-diff' + (urgent ? ' ven-prev-diff--urgent' : '') + '">' + diffLabel + '</span>';
      html += '</div>';
      html += '</div>';
    });

    document.getElementById('ven-prev-list').innerHTML = html;
  })();
</script>

<style>
  .ven-prev {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .ven-prev-head { margin-bottom: 2rem; }
  .ven-prev-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }
  @media (min-width: 720px) {
    .ven-prev-list {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  .ven-prev-loading,
  .ven-prev-empty {
    color: var(--fg-muted);
    font-size: 0.88rem;
    padding: 1rem 0;
    font-style: italic;
  }

  .ven-prev-item {
    display: flex;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    transition: all .2s ease;
  }
  .ven-prev-item:hover {
    border-color: var(--brand-500);
    transform: translateY(-2px);
  }
  .ven-prev-item--urgent {
    border-left: 3px solid #f59e0b;
  }

  .ven-prev-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
  }
  .ven-prev-day {
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  .ven-prev-month {
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-500);
    font-weight: 700;
    margin-top: 0.25rem;
  }
  .ven-prev-dow {
    font-family: var(--font-mono, monospace);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 0.15rem;
  }

  .ven-prev-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ven-prev-cats {
    font-family: var(--font-mono, monospace);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.3rem;
  }
  .ven-prev-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }
  .ven-prev-diff {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    font-weight: 700;
  }
  .ven-prev-diff--urgent { color: #f59e0b; }

  .ven-prev-cta {
    margin-top: 2rem;
    text-align: center;
  }
  .ven-prev-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--brand-500);
    padding: 0.6rem 1.2rem;
    border: 1.5px solid var(--brand-500);
    border-radius: 3px;
    transition: all .2s ease;
  }
  .ven-prev-link:hover {
    background: var(--brand-500);
    color: var(--bg);
  }
  .ven-prev-link span { transition: transform .2s ease; }
  .ven-prev-link:hover span { transform: translateX(3px); }
</style>
