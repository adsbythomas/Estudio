---
import '../styles/global.css';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import type { Practice } from '@lib/site';
import { ES_TO_EN, ES_TO_EN_PREFIXES } from '@lib/i18n';

export interface Props {
  title: string;
  description: string;
  practice: Practice;
  canonical?: string;
  /** false en subpáginas que NO tienen los anchors (#practica, #equipo, etc). */
  landing?: boolean;
}
const { title, description, practice, canonical, landing = true } = Astro.props;
const themeClass = practice === 'legal' ? 'theme-legal' : 'theme-accounting';
// Color oficial del brandbook (Midnight Slate) — igual para ambas páginas.
const themeColor = '#242b42';

const base = import.meta.env.BASE_URL;
const faviconHref = (base.endsWith('/') ? base.slice(0, -1) : base) + '/brand/isotipo.svg';
---
<!doctype html>
<html lang="es" class={themeClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <!-- HTML siempre revalidado: evita que el navegador sirva una versión vieja
         tras un deploy. Los assets (JS/CSS/imágenes) usan hash en el nombre,
         así que sí pueden cachearse agresivamente. -->
    <meta http-equiv="Cache-Control" content="no-cache, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Setear data-lang en <html> ASAP para evitar flicker del toggle -->
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem('plb-lang') || 'es';
          document.documentElement.setAttribute('data-lang', l);
        } catch (e) {
          document.documentElement.setAttribute('data-lang', 'es');
        }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={faviconHref} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Tipografías oficiales del brandbook: Montserrat (primaria) + Lora (secundaria).
         PT Sans se usa como mono/técnica para detalles de tipo tick. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=PT+Sans:wght@400;700&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': practice === 'legal' ? 'LegalService' : 'AccountingService',
      name: 'Pantarotto Lértora Bardagí & Asocs.',
      description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Av. Corrientes 1464, Piso 16 Of. 1605',
        postalCode: 'C1042',
        addressLocality: 'Buenos Aires',
        addressCountry: 'AR',
      },
      foundingDate: '2003',
    })} />
  </head>
  <body class="grain">
    <!-- Preloader con isotipo oficial del brandbook -->
    <div class="preloader" id="preloader" aria-hidden="true">
      <svg viewBox="0 0 1080 1080">
        <path class="pre-stroke" d="M935.67,0H144.23v1080h791.55l-.1-1080ZM885.48,1029.05H195.16V51.05h690.32v978.01Z"/>
        <path class="pre-stroke" d="M245.46,956.45l.62-56.23c0-144.32,89.97-237.19,225.4-287.07l363.05-148.71v487.39l-589.08,4.61Z"/>
        <path class="pre-stroke" d="M834.54,122.38l-1.87,56.23c0,144.32-89.97,237.19-225.4,287.07l-361.8,148.71V126.99l589.08-4.61Z"/>
      </svg>
      <div class="pre-label">Pantarotto Lértora Bardagí — Legal | Tax Accountants</div>
    </div>

    <!-- Skip -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:bg-white focus:px-4 focus:py-2 focus:z-50 focus:text-ink-900">Saltar al contenido</a>

    <Nav practice={practice} landing={landing} />

    <main id="main"><slot /></main>

    <Footer practice={practice} />

    <script is:inline>
      // ═══════════════════════════════════════════════════════════════════════
      // Init de la página. Se llama en el load inicial y en cada navegación
      // por View Transitions (evento `astro:page-load`). El scroll listener y
      // las variables de cache se atan una sola vez (flag `__plbInit`) para
      // evitar duplicados; los IntersectionObservers se recrean cada vez
      // porque el DOM se reemplaza.
      // ═══════════════════════════════════════════════════════════════════════
      (function () {
        // Estado a nivel sesión
        const State = (window.__plbState = window.__plbState || {
          scrollAttached: false,
          parallaxEls: [],
          progressBar: null,
          nav: null,
          revealIO: null,
          counterIO: null,
        });

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isSmallViewport = window.innerWidth < 768;
        const skipParallax = prefersReducedMotion || isSmallViewport;

        function attachScrollOnce() {
          if (State.scrollAttached) return;
          State.scrollAttached = true;

          let ticking = false;
          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              const h = document.documentElement;
              const scrolled = h.scrollHeight > h.clientHeight
                ? h.scrollTop / (h.scrollHeight - h.clientHeight) : 0;
              if (State.progressBar) State.progressBar.style.setProperty('--progress', String(scrolled));
              if (State.nav) State.nav.classList.toggle('solid', h.scrollTop > 40);

              if (!skipParallax) {
                const vhHalf = window.innerHeight / 2;
                for (let i = 0; i < State.parallaxEls.length; i++) {
                  const p = State.parallaxEls[i];
                  const rect = p.el.getBoundingClientRect();
                  const off = (rect.top + rect.height / 2 - vhHalf) * p.speed * -1;
                  p.el.style.transform = 'translate3d(0,' + off + 'px,0)';
                }
              }
              ticking = false;
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          State.onScroll = onScroll;
        }

        function splitWords(el) {
          if (el.dataset.wordSplit === '1') return;
          let wordIndex = 0;
          const TEXT_NODE = 3;
          const ELEMENT_NODE = 1;

          function process(node) {
            if (node.nodeType === TEXT_NODE) {
              const parts = (node.textContent || '').split(/(\s+)/);
              const frag = document.createDocumentFragment();
              parts.forEach((part) => {
                if (/^\s+$/.test(part)) {
                  frag.appendChild(document.createTextNode(part));
                } else if (part.length) {
                  const span = document.createElement('span');
                  span.className = 'word';
                  span.style.setProperty('--word-i', String(wordIndex++));
                  span.textContent = part;
                  frag.appendChild(span);
                }
              });
              node.parentNode.replaceChild(frag, node);
            } else if (node.nodeType === ELEMENT_NODE) {
              // Recursión sobre hijos (snapshot porque vamos a mutar)
              Array.from(node.childNodes).forEach(process);
            }
          }
          Array.from(el.childNodes).forEach(process);
          el.dataset.wordSplit = '1';
        }

        function initPage() {
          // Re-cachear referencias que cambian con cada page-load
          State.progressBar = document.getElementById('scrollProgress');
          State.nav = document.querySelector('[data-nav]');
          State.parallaxEls = Array.from(document.querySelectorAll('[data-parallax]')).map((el) => ({
            el, speed: parseFloat(el.getAttribute('data-parallax-speed') || '0.2'),
          }));

          attachScrollOnce();
          // Re-disparar onScroll para sincronizar progress bar / parallax con la posición actual
          if (State.onScroll) State.onScroll();

          // Word-split sobre los títulos marcados (para el reveal palabra-por-palabra)
          document.querySelectorAll('[data-word-reveal]').forEach((el) => splitWords(el));

          // Reveal IntersectionObserver (recreamos cada navegación)
          State.revealIO?.disconnect();
          State.revealIO = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in', 'in-view');
                const lines = e.target.querySelectorAll?.('[data-stack-line]');
                lines?.forEach?.((l, i) => setTimeout(() => l.classList.add('in'), i * 90));
                State.revealIO.unobserve(e.target);
              }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
          document.querySelectorAll('.reveal, .skyline, .blueprint, [data-stack-line], [data-team-row], [data-word-reveal]').forEach((el) => State.revealIO.observe(el));

          // Counters (count-up al entrar en viewport)
          State.counterIO?.disconnect();
          State.counterIO = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const target = parseFloat(e.target.getAttribute('data-target') || '0');
              const valEl = e.target.querySelector('[data-counter-val]') || e.target;
              const dur = 1600;
              const start = performance.now();
              const step = (t) => {
                const p = Math.min(1, (t - start) / dur);
                const ease = 1 - Math.pow(1 - p, 3);
                valEl.textContent = Math.round(target * ease).toString();
                if (p < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
              State.counterIO.unobserve(e.target);
            });
          }, { threshold: 0.4 });
          document.querySelectorAll('[data-counter]').forEach((c) => State.counterIO.observe(c));

          // Menú mobile (re-attach por DOM nuevo)
          const openBtn = document.getElementById('mob-open');
          const closeBtn = document.getElementById('mob-close');
          const mob = document.getElementById('mob');
          openBtn?.addEventListener('click', () => { mob?.classList.add('open'); document.body.style.overflow = 'hidden'; });
          closeBtn?.addEventListener('click', () => { mob?.classList.remove('open'); document.body.style.overflow = ''; });
          mob?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
            mob.classList.remove('open'); document.body.style.overflow = '';
          }));

          // Form feedback
          document.querySelectorAll('form[data-contact]').forEach((form) => {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              const btn = form.querySelector('button[type="submit"]');
              if (!btn) return;
              btn.querySelector('span').textContent = 'Consulta enviada · gracias';
              btn.setAttribute('disabled', 'true');
              btn.style.background = '#2f5d38';
            });
          });

          // Índice de prácticas — contador activo al hover
          const indexItems = document.querySelectorAll('[data-index-item]');
          const indexCount = document.querySelector('[data-index-count]');
          indexItems.forEach((it, i) => {
            it.addEventListener('mouseenter', () => {
              if (indexCount) indexCount.textContent = String(i + 1).padStart(2, '0');
            });
          });
        }

        // Preloader: una sola vez
        window.addEventListener('load', () => {
          setTimeout(() => document.getElementById('preloader')?.classList.add('done'), 350);
        }, { once: true });

        // Init en page-load (View Transitions). Si el evento ya pasó, ejecutar igual.
        document.addEventListener('astro:page-load', initPage);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          initPage();
        }
      })();
    </script>

    <!-- ═══════════════════════════════════════════════
         i18n — toggle ES/EN con persistencia en localStorage
         ═══════════════════════════════════════════════ -->
    <script is:inline define:vars={{ ES_TO_EN, ES_TO_EN_PREFIXES }}>
      (function () {
        var STORAGE_KEY = 'plb-lang';
        var EN_TO_ES = {};
        for (var k in ES_TO_EN) {
          if (Object.prototype.hasOwnProperty.call(ES_TO_EN, k)) {
            EN_TO_ES[ES_TO_EN[k]] = k;
          }
        }
        var EN_TO_ES_PREFIXES = ES_TO_EN_PREFIXES.map(function (p) { return [p[1], p[0]]; });

        function walkTextNodes(root) {
          var nodes = [];
          var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode: function (n) {
              var p = n.parentElement;
              if (!p) return NodeFilter.FILTER_REJECT;
              var tag = p.tagName;
              if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'NOSCRIPT') return NodeFilter.FILTER_REJECT;
              if (p.closest('[data-no-translate]')) return NodeFilter.FILTER_REJECT;
              if (!n.textContent || !n.textContent.trim()) return NodeFilter.FILTER_REJECT;
              return NodeFilter.FILTER_ACCEPT;
            }
          });
          var node;
          while ((node = walker.nextNode())) nodes.push(node);
          return nodes;
        }

        function translateString(text, dict, prefixes) {
          var trimmed = text.trim();
          if (!trimmed) return null;
          if (dict[trimmed]) return text.replace(trimmed, dict[trimmed]);
          for (var i = 0; i < prefixes.length; i++) {
            var pa = prefixes[i][0];
            var pb = prefixes[i][1];
            if (trimmed.indexOf(pa) === 0) {
              return text.replace(pa, pb);
            }
          }
          return null;
        }

        var ATTRS = ['aria-label', 'placeholder', 'alt', 'title'];

        function applyLang(lang) {
          var dict = lang === 'en' ? ES_TO_EN : EN_TO_ES;
          var prefixes = lang === 'en' ? ES_TO_EN_PREFIXES : EN_TO_ES_PREFIXES;

          // 1) Text nodes
          var nodes = walkTextNodes(document.body);
          for (var i = 0; i < nodes.length; i++) {
            var n = nodes[i];
            var updated = translateString(n.textContent, dict, prefixes);
            if (updated !== null) n.textContent = updated;
          }

          // 2) Atributos comunes
          for (var a = 0; a < ATTRS.length; a++) {
            var attr = ATTRS[a];
            var els = document.querySelectorAll('[' + attr + ']');
            els.forEach(function (el) {
              var v = el.getAttribute(attr);
              if (!v) return;
              var trimmed = v.trim();
              if (dict[trimmed]) el.setAttribute(attr, v.replace(trimmed, dict[trimmed]));
            });
          }

          // 3) <title>
          var tt = document.title.trim();
          if (dict[tt]) document.title = dict[tt];

          // 4) lang attr
          document.documentElement.setAttribute('lang', lang);
          document.documentElement.setAttribute('data-lang', lang);

          try { localStorage.setItem(STORAGE_KEY, lang); } catch (e) {}
        }

        // Exponer para el botón toggle
        window.__applyLang = applyLang;

        // Aplicar el idioma guardado al cargar la página
        var stored = 'es';
        try { stored = localStorage.getItem(STORAGE_KEY) || 'es'; } catch (e) {}
        if (stored === 'en') applyLang('en');
        else document.documentElement.setAttribute('data-lang', 'es');

        // Wire del botón de toggle
        document.querySelectorAll('[data-lang-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'es';
            applyLang(current === 'en' ? 'es' : 'en');
          });
        });
      })();
    </script>
  </body>
</html>
